{
  "schema_version": "1.0",
  "site_id": "zona-02",
  "cms_contract": "1.2.0",
  "site_type": "video-showcase",
  "domains": [
    "zonafilm.cc"
  ],
  "locale": "ru-RU",
  "timezone": "Europe/Moscow",
  "theme": {
    "name": "lords-showcase"
  },
  "content_providers": [
    {
      "adapter": "cdnvideohub-public-v1",
      "role": "primary",
      "directions": [
        "movie",
        "series"
      ],
      "credentials_ref": "cdnvideohub_api_token"
    }
  ],
  "content_directions": [
    "movie",
    "series"
  ],
  "enabled_modules": [
    "content-ingestion",
    "content-catalog",
    "episodes-seasons",
    "playback-availability",
    "homepage-shelves",
    "ratings",
    "seo",
    "site-configuration",
    "cache-invalidation",
    "monitoring-audit",
    "provider-adapters",
    "renderer-adapters"
  ],
  "shelf_configuration": [
    {
      "shelf_id": "new-titles",
      "title": "Новинки каталога",
      "source": "query",
      "requires_playback": true,
      "limit": 18,
      "position": 0
    },
    {
      "shelf_id": "recently-added",
      "title": "Последние добавления",
      "source": "query",
      "requires_playback": true,
      "limit": 18,
      "position": 1
    },
    {
      "shelf_id": "top-rated",
      "title": "Высокие оценки",
      "source": "query",
      "requires_playback": true,
      "limit": 18,
      "position": 2
    }
  ],
  "render_strategy": {
    "mode": "static",
    "release_size_budget_mb": 1600,
    "full_render_budget_minutes": 120
  },
  "cache_policy": {
    "schema_version": "1.0",
    "layers": {
      "new_episodes": {
        "ttl_seconds": 300,
        "stale_while_revalidate_seconds": 120,
        "last_known_good": true,
        "tags": [
          "shelf:new-episodes",
          "events"
        ]
      },
      "homepage_shelves": {
        "ttl_seconds": 300,
        "stale_while_revalidate_seconds": 300,
        "last_known_good": true,
        "tags": [
          "shelf"
        ]
      },
      "catalog": {
        "ttl_seconds": 900,
        "stale_while_revalidate_seconds": 600,
        "last_known_good": true,
        "tags": [
          "catalog"
        ]
      },
      "title_page": {
        "ttl_seconds": 900,
        "stale_while_revalidate_seconds": 600,
        "last_known_good": true,
        "tags": [
          "title"
        ]
      },
      "ratings": {
        "ttl_seconds": 21600,
        "stale_while_revalidate_seconds": 3600,
        "last_known_good": true,
        "tags": [
          "ratings"
        ]
      },
      "schedule": {
        "ttl_seconds": 1800,
        "stale_while_revalidate_seconds": 600,
        "last_known_good": true,
        "tags": [
          "schedule"
        ]
      },
      "announcements": {
        "ttl_seconds": 1800,
        "stale_while_revalidate_seconds": 600,
        "last_known_good": true,
        "tags": [
          "announcements"
        ]
      },
      "seo": {
        "ttl_seconds": 3600,
        "stale_while_revalidate_seconds": 1800,
        "last_known_good": true,
        "tags": [
          "seo"
        ]
      },
      "static_assets": {
        "ttl_seconds": 86400,
        "last_known_good": true,
        "tags": [
          "static"
        ]
      }
    },
    "invalidation": {
      "mode": "event-driven",
      "event_map": {
        "EPISODE_ADDED": [
          "title",
          "shelf:new-episodes",
          "catalog"
        ],
        "TITLE_CREATED": [
          "shelf:new-titles",
          "catalog"
        ],
        "PLAYBACK_AVAILABLE": [
          "title",
          "shelf:watchable"
        ],
        "RATING_UPDATED": [
          "title",
          "ratings"
        ],
        "SCHEDULE_UPDATED": [
          "schedule"
        ],
        "ANNOUNCEMENT_UPDATED": [
          "announcements"
        ]
      },
      "dry_run_supported": true
    },
    "keys": {
      "site_scoped": true,
      "stampede_protection": "coalesce"
    },
    "forbidden": {
      "cache_errors": false,
      "empty_response_as_success": false,
      "indefinite_html_cache": false
    },
    "observability": {
      "expose_hit_miss_stale": true
    }
  },
  "seo_profile": {
    "enabled": true,
    "indexing_enabled": false,
    "canonical_host": "zonafilm.cc",
    "editorial_profile": null
  },
  "analytics_profile": {
    "enabled": false,
    "provider": null,
    "counter_id": null,
    "allowed_hosts": [
      "zonafilm.cc"
    ],
    "blocked_reason": "BLOCKED_EXTERNAL_CREDENTIAL: отдельный счётчик для zonafilm.cc не создан — нет доступа к API Яндекс.Метрики. Счётчик соседней витрины не подставлен намеренно: он писал бы события не туда."
  },
  "legal_profile": {
    "contact_email": null,
    "owner": null,
    "documents": null,
    "blocked_reason": "BLOCKED_INPUT: правовые данные нового сайта владельцем не переданы. Пустое поле — не разрешение взять их у соседней витрины."
  },
  "release_policy": {
    "keep_releases": 2,
    "rollback_ready": true,
    "zero_downtime_switch": true
  },
  "feature_flags": {
    "ad_slots_enabled": false
  },
  "owners": {
    "content-ingestion": "site-factory/content",
    "seo": "site-factory/seo",
    "renderer-adapters": "site-factory/platform",
    "monitoring-audit": "site-factory/platform"
  },
  "health_endpoint": "/healthz",
  "coverage_endpoint": "/api/v1/coverage",
