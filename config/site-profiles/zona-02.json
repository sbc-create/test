    "credential_profile": null,
    "publisher_id_ref": null,
    "sidecar": "/srv/lords/.frontend/player-zona-02.json",
    "source_mode": "provider-id",
    "blocked_reason": "BLOCKED_EXTERNAL_CREDENTIAL: Publisher ID витрине не выдан. Пара учётных данных соседней витрины не переиспользуется без решения владельца: у провайдера publisher привязан к перечню доменов, и zonafilm.cc в нём не подтверждён. До выдачи рантайм честно отдаёт состояние noaccess без пустого iframe."
  }
}
