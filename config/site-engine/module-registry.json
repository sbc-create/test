{
  "schema_version": "1.0",
  "modules": [
    {
      "id": "core-contracts",
      "status": "IMPLEMENTED",
      "purpose": "Схемы и типы, на которые ссылаются все остальные. Ничего не делает сам.",
      "owns": "определения нормализованной модели и контрактов",
      "public_interface": [
        "schemas/site-engine/*.schema.json",
        "factory.site_engine.contracts"
      ],
      "inputs": [],
      "outputs": [
        "JSON Schema",
        "типы"
      ],
      "events": [],
      "depends_on": [],
      "forbidden": [
        "любой модуль, любой фреймворк, любая БД, любой поставщик"
      ],
      "errors": [
        "SchemaError"
      ],
      "metrics": [],
      "cache_tags": [],
      "implementation": "factory/site_engine/contracts.py"
    },
    {
      "id": "site-configuration",
      "status": "IMPLEMENTED",
      "purpose": "Профиль сайта: всё, что отличает сайт от сайта.",
      "owns": "профили сайтов и флаги",
      "public_interface": [
        "factory.site_engine.profiles"
      ],
      "inputs": [
        "config/site-profiles/*.json"
      ],
      "outputs": [
        "SiteProfile"
      ],
      "events": [],
      "depends_on": [
        "core-contracts"
      ],
      "forbidden": [
        "provider-adapters",
        "content-ingestion",
        "renderer-adapters"
      ],
      "errors": [
        "ProfileNotFound",
        "ProfileInvalid"
      ],
      "metrics": [
        "profiles_loaded"
      ],
      "cache_tags": [],
      "implementation": "factory/site_engine/profiles.py"
    },
    {
      "id": "provider-adapters",
      "status": "ADAPTED",
      "purpose": "Перевод чужого API в наш контракт. Знает про HTTP, не знает про витрины.",
      "owns": "сырые ответы поставщика",
      "public_interface": [
        "factory.site_engine.providers.ProviderAdapter"
      ],
      "inputs": [
        "внешний API"
      ],
      "outputs": [
        "RawTitle",
        "RawSeason"
      ],
      "events": [],
      "depends_on": [
        "core-contracts"
      ],
      "forbidden": [
        "renderer-adapters",
        "seo-bridge",
        "shelves",
        "editorial"
      ],
      "errors": [
        "ProviderUnavailable",
        "ProviderContractBroken"
      ],
      "metrics": [
        "provider_requests",
        "provider_failures"
      ],
      "cache_tags": [],
      "implementation": "factory/site_engine/providers.py"
    },
    {
      "id": "content-ingestion",
      "status": "ADAPTED",
      "purpose": "Обход поставщика и наполнение нормализованного хранилища.",
      "owns": "состояние обхода и полноту",
      "public_interface": [
        "factory.site_engine.ingestion"
      ],
      "inputs": [
        "ProviderAdapter"
      ],
      "outputs": [
        "IngestionRun",
        "CoverageReport"
      ],
      "events": [
        "TITLE_CREATED",
        "TITLE_UPDATED",
        "EPISODE_ADDED",
        "SEASON_ADDED",
        "SOURCE_ANOMALY"
      ],
      "depends_on": [
        "core-contracts",
        "provider-adapters",
        "normalized-content"
      ],
      "forbidden": [
        "seo-bridge",
        "renderer-adapters",
        "shelves",
        "editorial"
      ],
      "errors": [
        "SourceError",
        "CatalogTruncation"
      ],
      "metrics": [
        "titles_seen",
        "pages_walked",
        "detail_failures"
      ],
      "cache_tags": [],
      "implementation": "factory/site_engine/ingestion.py"
    },
    {
      "id": "normalized-content",
      "status": "IMPLEMENTED",
      "purpose": "Нормализованное хранилище: единственный источник правды о содержимом.",
      "owns": "Title, Season, Episode и их канонические идентификаторы",
      "public_interface": [
        "factory.site_engine.store.NormalizedStore"
      ],
      "inputs": [
        "записи от ingestion"
      ],
      "outputs": [
        "Title",
        "Season",
        "Episode"
      ],
      "events": [],
      "depends_on": [
        "core-contracts"
      ],
      "forbidden": [
        "provider-adapters",
        "renderer-adapters",
        "seo-bridge"
      ],
      "errors": [
        "TitleNotFound"
      ],
      "metrics": [
        "titles_stored"
      ],
      "cache_tags": [
        "catalog",
        "title"
      ],
      "implementation": "factory/site_engine/store.py"
    },
    {
      "id": "catalog",
      "status": "CONTRACT_ONLY",
      "purpose": "Выборки по нормализованному хранилищу: фильтры, сортировки, страницы.",
      "owns": "правила выборки, но не сами данные",
      "public_interface": [
        "CatalogQuery"
      ],
      "inputs": [
        "NormalizedStore"
      ],
      "outputs": [
        "Page[Title]"
      ],
      "events": [],
      "depends_on": [
        "core-contracts",
        "normalized-content"
      ],
      "forbidden": [
        "provider-adapters",
        "content-ingestion",
        "seo-bridge"
      ],
      "errors": [
        "QueryInvalid"
      ],
      "metrics": [
        "catalog_queries"
      ],
      "cache_tags": [
        "catalog"
      ],
      "implementation": null
    },
    {
      "id": "episodes-seasons",
      "status": "CONTRACT_ONLY",
      "purpose": "Сезоны, серии и дельта серий.",
      "owns": "счётчики сезонов и вывод о прибавке",
      "public_interface": [
        "EpisodeDelta"
      ],
      "inputs": [
        "NormalizedStore"
      ],
      "outputs": [
        "Season",
        "Episode"
      ],
      "events": [
        "EPISODE_ADDED",
        "SEASON_ADDED"
