      ],
      "cache_tags": [
        "title",
        "shelf:watchable"
      ],
      "implementation": null
    },
    {
      "id": "shelves",
      "status": "CONTRACT_ONLY",
      "purpose": "Состав и порядок полок витрины.",
      "owns": "полки",
      "public_interface": [
        "ShelfBuilder"
      ],
      "inputs": [
        "catalog",
