        "episodes_added"
      ],
      "cache_tags": [
        "title",
        "shelf:new-episodes"
      ],
      "implementation": null
    },
    {
      "id": "playback",
      "status": "CONTRACT_ONLY",
      "purpose": "Признак «смотрибельно» и ничего кроме.",
      "owns": "PlaybackAvailability",
