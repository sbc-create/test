[Unit]
Description=Ежедневный сбор SEO-данных после появления полного дня

[Timer]
# 06:30 по времени портфеля: данные за вчера уже сформированы у Метрики,
# Вебмастер отдаёт вчерашний срез. Раньше запускать бессмысленно —
# соберём неполный день и будем сравнивать его с полными.
OnCalendar=*-*-* 06:30:00
# Разброс, чтобы 100+ сайтов не начинали дёргать API одновременно.
RandomizedDelaySec=600
# Пропущенный из-за перезагрузки запуск выполняется при старте.
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
