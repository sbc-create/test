{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sbc-create/test/schemas/provider-defect-watch.schema.json",
  "title": "Provider Defect Watch",
  "description": "Records that vanished from a provider snapshot and are re-checked after every catalog delivery (automation/local/provider-defect-watch.py). A watch entry without the date it was lost, the public pages and the snapshots to look in cannot be checked.",
  "type": "object",
  "additionalProperties": false,
  "required": ["watch"],
  "properties": {
    "about": {"type": "string"},
    "watch": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "title", "lost_at", "pages", "catalogs"],
        "properties": {
          "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "title": {"type": "string", "minLength": 1},
          "lost_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "pages": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^https://"}},
          "catalogs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^/"}}
        }
      }
    }
  }
}
