{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://site-factory.local/schemas/site-matrix.schema.json",
  "title": "SITE-MATRIX",
  "description": "Производная матрица сайтов. Источник истины — config/site-profiles/*.json; этот файл порождается из них и правится только через профиль. Схема существует затем, чтобы порча генератора была видна сразу, а не на выкатке.",
  "type": "object",
  "required": ["schema_version", "generated_from", "sites"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "generated_from": { "type": "string", "minLength": 1 },
    "note": { "type": "string" },
    "sites": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/site" }
    }
  },
  "$defs": {
    "site": {
      "type": "object",
      "required": [
        "site_id", "site_type", "domains", "locale", "timezone",
        "theme", "directions", "providers", "render_mode", "modules",
        "seo", "normalized_content_source", "keep_releases",
        "health_endpoint", "coverage_endpoint"
      ],
      "additionalProperties": false,
      "properties": {
        "site_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "site_type": { "type": "string", "minLength": 1 },
        "domains": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z0-9.-]+$" }
        },
        "locale": { "type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$" },
        "timezone": { "type": "string", "minLength": 1 },
        "theme": {
          "type": "object",
          "required": ["name"],
          "additionalProperties": false,
          "properties": { "name": { "type": "string", "minLength": 1 } }
        },
        "directions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "providers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "render_mode": { "type": "string", "enum": ["static", "hybrid", "dynamic"] },
        "modules": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "seo": {
          "type": "object",
          "required": ["enabled", "indexing_enabled", "canonical_host"],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "indexing_enabled": { "type": "boolean" },
            "canonical_host": { "type": "string", "pattern": "^[a-z0-9.-]+$" }
          }
        },
        "normalized_content_source": {
          "type": "object",
          "required": ["kind", "ref"],
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "ref": { "type": "string", "minLength": 1 }
          }
        },
        "keep_releases": { "type": "integer", "minimum": 1 },
        "health_endpoint": { "type": "string", "pattern": "^/" },
        "coverage_endpoint": { "type": "string", "pattern": "^/" }
      }
    }
  }
}
