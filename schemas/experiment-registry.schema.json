{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sbc-create/test/schemas/experiment-registry.schema.json",
  "title": "Experiment Registry",
  "description": "Every experiment the operator has run, with its scope, verdict and the evidence behind that verdict. Feeds the learning playbook.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "experiments"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "note": {"type": "string"},
    "experiments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["experiment_id", "site_id", "hypothesis", "primary_metric", "phase"],
        "properties": {
          "experiment_id": {"type": "string", "pattern": "^exp-[a-z0-9-]+$"},
          "site_id": {"type": "string", "pattern": "^[a-z0-9]{2,}(-[a-z0-9]+)*$"},
          "synthetic": {"type": "boolean"},
          "hypothesis": {"type": "string", "minLength": 1},
          "primary_metric": {"type": "string", "minLength": 1},
          "applicability": {"type": "string"},
          "scope_page_share": {"type": "number", "minimum": 0, "maximum": 0.1,
            "description": "Canary limit: never more than 10% of a site's pages."},
          "phase": {
            "type": "string",
            "enum": ["proposed", "dry_run", "canary", "observing", "kept", "rolled_back", "aborted"]
          },
          "observation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "days_elapsed": {"type": "integer", "minimum": 0},
              "impressions": {"type": "integer", "minimum": 0},
              "primary_metric_delta": {"type": "number"}
            }
          },
          "verdict": {
            "type": "string",
            "enum": ["keep", "rollback", "continue", "insufficient_data"]
          },
          "verdict_reason": {"type": "string"},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
