{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://site-factory.local/schemas/topvisor-cores.schema.json",
  "title": "Topvisor keyword cores",
  "description": "Ядро запросов Топвизора по сайтам: что отслеживать, на какой целевой адрес и почему. Строится automation/local/topvisor-core.py из измеренных поисковых входов Метрики и стратегии манифеста. Визиты в basis — основание выбора, а не клики и не позиции. Смена состава запросов отмечается новой версией (version + changes), чтобы замеры оставались сопоставимыми.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "built_at",
    "source",
    "measurement",
    "sites"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "built_at": {
      "type": "string",
      "format": "date-time"
    },
    "note": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metrika",
        "collected_at",
        "measure",
        "dates"
      ],
      "properties": {
        "metrika": {
          "type": "string",
          "minLength": 1
        },
        "collected_at": {
          "type": "string"
        },
        "measure": {
          "const": "daily_search_landing_pages"
        },
        "dates": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region",
        "searchers",
        "device",
        "depth",
        "schedule",
        "status"
      ],
      "properties": {
        "region": {
          "type": "string",
          "minLength": 1,
          "description": "Имя региона в сервисе (ключ берётся из ответа сервиса, не задаётся числом)."
        },
        "searchers": {
          "type": "array",
          "items": {
            "enum": [
              "yandex",
              "google"
            ]
          },
          "minItems": 1
        },
        "device": {
          "type": "string",
          "minLength": 1
        },
        "depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "Глубина в единицах Топвизора: 1–3 для Яндекса, 1–10 для Google (документация 26.10.2026); перевод в число позиций документом не назван."
        },
        "schedule": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "prepared",
            "awaiting_owner_budget",
            "active"
          ]
        },
        "note": {
          "type": "string"
        },
        "region_country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "searcher",
              "device"
            ],
            "properties": {
              "searcher": {
                "enum": [
                  "yandex",
                  "google"
                ]
              },
              "device": {
                "enum": [
                  "desktop",
                  "tablet",
                  "smartphone"
                ]
              }
            }
          }
        },
        "collect": {
          "type": "string",
          "minLength": 1
        },
        "measure": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "at",
          "what"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "at": {
            "type": "string"
          },
          "what": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "groups"
        ],
        "properties": {
          "domain": {
            "type": "string",
            "format": "hostname"
          },
          "strategy": {
            "type": [
              "string",
              "null"
            ]
          },
          "in_manifest": {
            "type": "boolean"
          },
          "search_visits": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "skipped": {
            "type": "array"
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "keywords"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "keywords": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "query",
                      "target_url",
                      "basis"
                    ],
                    "properties": {
                      "query": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 255
                      },
                      "target_url": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "pattern": "^https://"
                      },
                      "basis": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
