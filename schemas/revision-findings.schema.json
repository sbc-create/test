{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://site-factory.local/schemas/revision-findings.schema.json",
  "title": "Revision findings",
  "description": "Итоги ревизии сети: подтверждённые находки, гипотезы, предложения, проверенно исправное и заметки о методе.\n\nСхема появилась 2026-10-18: `scripts/validate_registries.py` считает провалом реестр, не сопоставленный ни одной схеме, и этот реестр висел непроверенным. Отсутствие схемы — пробел, а не разрешение.\n\nГлавное, что схема держит, — РАЗДЕЛЕНИЕ РОДОВ УТВЕРЖДЕНИЙ, ради которого реестр и устроен четырьмя списками. Подтверждённая находка обязана нести доказательство, ожидаемое поведение и фактическое — иначе это гипотеза; гипотеза обязана объяснять, ПОЧЕМУ она гипотеза, и называть следующий шаг — иначе это находка без доказательства; предложение обязано называть ценность. Смешать их молча схема не даёт.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "created_at", "confirmed"],
  "properties": {
    "schema": {"type": "string", "pattern": "^revision-findings/[0-9]+\\.[0-9]+$"},
    "created_at": {"type": "string", "minLength": 10},
    "updated_at": {"type": "string", "minLength": 10},
    "author": {"type": "string"},
    "note": {"type": "string"},
    "measurement_boundaries": {
      "description": "Что эта ревизия НЕ измеряла. Список границ — часть результата: без него читатель примет пробел за отсутствие проблемы.",
      "type": "array",
      "items": {"type": "string", "minLength": 10}
    },
    "confirmed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sites", "component", "expected", "actual",
                     "evidence", "priority", "acceptance"],
        "properties": {
          "id": {"type": "string", "pattern": "^R-[0-9]{2,}$"},
          "sites": {"type": "array", "items": {"type": "string", "minLength": 3}},
          "component": {"type": "string", "minLength": 3},
          "expected": {"type": "string", "minLength": 10},
          "actual": {"type": "string", "minLength": 10},
          "evidence": {"type": "string", "minLength": 10},
          "impact": {"type": "string", "minLength": 5},
          "priority": {"enum": ["P0", "P1", "P2", "P3"]},
          "fix": {"type": "string", "minLength": 10},
          "dependencies": {"type": "string"},
          "effort": {"type": "string"},
          "acceptance": {"type": "string", "minLength": 10},
          "status": {"type": "string", "minLength": 3}
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "evidence", "why_hypothesis",
                     "next_step"],
        "properties": {
          "id": {"type": "string", "pattern": "^H-[0-9]{2,}$"},
          "sites": {"type": "array", "items": {"type": "string"}},
          "component": {"type": "string"},
          "statement": {"type": "string", "minLength": 10},
          "evidence": {"type": "string", "minLength": 5},
          "why_hypothesis": {"type": "string", "minLength": 10},
          "next_step": {"type": "string", "minLength": 5}
        }
      }
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "proposal", "value"],
        "properties": {
          "id": {"type": "string", "pattern": "^P-[0-9]{2,}$"},
          "sites": {"type": "array", "items": {"type": "string"}},
          "component": {"type": "string"},
          "proposal": {"type": "string", "minLength": 10},
          "evidence": {"type": "string"},
          "value": {"type": "string", "minLength": 5},
          "depends_on": {"type": "string"}
        }
      }
    },
    "verified_working": {
      "description": "Проверенно исправное. Доказательство обязательно: «работает» без прогона — это не результат проверки, а впечатление.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "evidence"],
        "properties": {
          "item": {"type": "string", "minLength": 5},
          "evidence": {"type": "string", "minLength": 5}
        }
      }
    },
    "method_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["note", "consequence"],
        "properties": {
          "note": {"type": "string", "minLength": 10},
          "consequence": {"type": "string", "minLength": 5},
          "fixed": {"type": "string"}
        }
      }
    }
  }
}
