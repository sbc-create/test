{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://site-factory.local/schemas/credential-boundary.schema.json",
  "title": "Templates credential boundary snapshot",
  "description": "Что юнит templates-cp-consumer фактически видит на живом хосте: под какой учётной записью работает, какие credential ему доступны, что ему запрещено. Снимок снимается только host-контуром; в CI по нему проверяются схема, разбор и правило — но не сегодняшнее состояние машины.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_version",
    "unit",
    "user",
    "active_state",
    "shared_env_readers",
    "environment_files",
    "foreign_credential_refs",
    "secrets_in_env",
    "process_args",
    "child_process_args",
    "denials",
    "changeset_roles_templates",
    "model_forbidden_actions"
  ],
  "properties": {
    "snapshot_version": { "const": "credential-boundary/1.0.0" },
    "unit": { "type": "string", "minLength": 1 },
    "user": { "type": "string", "minLength": 1 },
    "active_state": { "type": "string", "minLength": 1 },
    "shared_env_readers": {
      "description": "Сколько посторонних юнитов читает общий env-файл. Единственное допустимое значение — 0, но схема его не навязывает: схема описывает форму, правило живёт в проверке.",
      "type": "integer",
      "minimum": 0
    },
    "environment_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "foreign_credential_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "secrets_in_env": {
      "description": "Имена переменных, похожих на секреты. Значения сюда не попадают и попасть не могут.",
      "type": "array",
      "items": { "type": "string" }
    },
    "process_args": { "type": "string" },
    "child_process_args": {
      "type": "array",
      "items": { "type": "string" }
    },
    "denials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_private_key",
        "credentials_dir",
        "sudo",
        "site_unit_restart",
        "operator_home",
        "docker"
      ],
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": { "type": "boolean" }
      }
    },
    "changeset_roles_templates": {
      "type": "array",
      "items": { "type": "string" }
    },
    "model_forbidden_actions": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
