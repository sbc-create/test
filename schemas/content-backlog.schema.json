{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sbc-create/test/schemas/content-backlog.schema.json",
  "title": "Content Backlog",
  "description": "Per-site content backlog. Every item states why it is worth doing; an item without a rationale cannot be prioritised against another.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "backlogs"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "note": {"type": "string"},
    "backlogs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["site_id", "items"],
        "properties": {
          "site_id": {"type": "string", "pattern": "^[a-z0-9]{2,}(-[a-z0-9]+)*$"},
          "synthetic": {"type": "boolean"},
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["item_id", "title", "rubric", "intent", "state", "rationale"],
              "properties": {
                "item_id": {"type": "string", "pattern": "^bkl-[a-z0-9-]+$"},
                "title": {"type": "string", "minLength": 1},
                "rubric": {"type": "string", "minLength": 1},
                "intent": {
                  "type": "string",
                  "enum": ["informational", "navigational", "commercial", "transactional"]
                },
                "state": {
                  "type": "string",
                  "enum": ["idea", "ready", "scheduled", "published", "dropped"]
                },
                "priority": {"type": "number", "minimum": 0},
                "rationale": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
