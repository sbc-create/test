{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://site-factory/schemas/site-announcements.schema.json",
  "title": "Анонсы витрины: объявленные релизы, которых ещё нет в просмотре",
  "description": "Блок «Ждём премьеру». Анонс НЕ обещает просмотр: у работы может не быть ни записи в каталоге, ни источника видео. Поэтому у каждой позиции обязателен источник объявления и дата, а ссылки на плеер нет по устройству блока.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "site", "site_id", "updated", "title", "intro", "items"],
  "properties": {
    "schema": {"const": "site-announcements/1"},
    "site": {"type": "string", "minLength": 4},
    "site_id": {"type": "string", "minLength": 3},
    "updated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "Дата последней сверки дат и источников."},
    "title": {"type": "string", "minLength": 4},
    "intro": {"type": "string", "minLength": 40,
              "description": "Чем является этот блок: объявленные релизы, а не доступные просмотры."},
    "note": {"type": "string"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "name", "release", "source", "reason"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "name": {"type": "string", "minLength": 2},
          "original_name": {"type": "string"},
          "release": {
            "type": "object",
            "additionalProperties": false,
            "required": ["date", "kind", "territory"],
            "properties": {
              "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
              "kind": {"enum": ["кинотеатральный", "цифровой", "платформа",
                                 "премьера сезона", "новая серия"],
                        "description": "Кинотеатральный и цифровой выпуск — разные события; премьера сезона не равна новой серии."},
              "territory": {"type": "string", "minLength": 3,
                            "description": "Территория объявленного выпуска. Зарубежная дата не является датой появления у нас."},
              "second": {
                "type": "object",
                "additionalProperties": false,
                "required": ["date", "kind", "territory"],
                "properties": {
                  "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
                  "kind": {"enum": ["кинотеатральный", "цифровой", "платформа",
                                     "премьера сезона", "новая серия"]},
                  "territory": {"type": "string", "minLength": 3}
                },
                "description": "Второе объявленное событие той же работы (например, кино, затем платформа)."
              }
            }
          },
          "source": {"type": "string", "minLength": 10,
                     "description": "Официальный источник объявления."},
          "reason": {"type": "string", "minLength": 20,
                     "description": "Человеческое пояснение: почему ждём. Технические правила сюда не попадают."},
          "catalog": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["id", "slug", "playable"],
            "properties": {
              "id": {"type": "string", "minLength": 8},
              "slug": {"type": "string", "minLength": 1},
              "playable": {"type": "boolean"}
            },
            "description": "Запись каталога, если работа уже в нём есть. `playable: true` означает, что анонс пора убирать: работа уже доступна."
          },
          "checked": {"type": "string", "minLength": 10}
        }
      }
    }
  }
}
