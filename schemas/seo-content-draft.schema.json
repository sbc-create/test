{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEOContentDraft.v1",
  "description": "Черновик SEO-контента. Модель приносит текст; владельца, окружение, идентификаторы, состояние публикации и переходы назначает сервер. Присланное значение служебного поля отклоняется как превышение роли, а не отфильтровывается молча.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "resource_kind",
    "site_id",
    "entity_type",
    "entity_id",
    "locale",
    "fact_pack_version",
    "fact_pack_sha256",
    "model_version",
    "prompt_version",
    "generation_parameters",
    "quality_gate_status",
    "idempotency_key",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "seo.content.draft/1.0.0"
    },
    "resource_kind": {
      "const": "seo.content.draft"
    },
    "site_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,127}$"
    },
    "entity_type": {
      "enum": [
        "title",
        "season",
        "episode"
      ]
    },
    "entity_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
    },
    "fact_pack_version": {
      "type": "integer",
      "minimum": 1
    },
    "fact_pack_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "generation_parameters": {
      "type": "object"
    },
    "meta_title": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "meta_description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 600
    },
    "h1_recommendation": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "body_description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 20000
    },
    "editorial_notes": {
      "type": "array",
      "maxItems": 3,
      "description": "Полная схема заметки — schemas/seo-editorial-note.schema.json. Здесь повторены только те ограничения, ослабление которых превратило бы заметку в поддельный отзыв; отдельный тест следит, чтобы обе схемы не разошлись.",
      "items": {
        "type": "object",
        "required": [
          "resource_kind",
          "comment_mode",
          "author_type",
          "text",
          "fact_refs"
        ],
        "properties": {
          "resource_kind": {
            "const": "seo.editorial_note"
          },
          "comment_mode": {
            "const": "EDITORIAL_COMMENTARY"
          },
          "author_type": {
            "const": "EDITORIAL_AI"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "fact_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "aggregateRating"
              ]
            },
            {
              "required": [
                "author_avatar"
              ]
            },
            {
              "required": [
                "author_name"
              ]
            },
            {
              "required": [
                "dislikes"
              ]
            },
            {
              "required": [
                "helpful_count"
              ]
            },
            {
              "required": [
                "likes"
              ]
            },
            {
              "required": [
                "nickname"
              ]
            },
            {
              "required": [
                "persona"
              ]
            },
            {
              "required": [
                "posted_at"
              ]
            },
            {
              "required": [
                "rating"
              ]
            },
            {
              "required": [
                "rating_value"
              ]
            },
            {
              "required": [
                "replies"
              ]
            },
            {
              "required": [
                "reply_to"
              ]
            },
            {
              "required": [
                "reviewRating"
              ]
            },
            {
              "required": [
                "review_body"
              ]
            },
            {
              "required": [
                "stars"
              ]
            },
            {
              "required": [
                "upvotes"
              ]
            },
            {
              "required": [
                "user_id"
              ]
            },
            {
              "required": [
                "watched_at"
              ]
            }
          ]
        }
      }
    },
    "faq_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "answer",
          "fact_refs"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "answer": {
            "type": "string",
            "minLength": 1
          },
          "fact_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "Вопрос появляется только там, где есть подтверждённый ответ."
    },
    "claim_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "text",
          "field",
          "claim_type",
          "verdict"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "claim_type": {
            "type": "string"
          },
          "verdict": {
            "enum": [
              "SUPPORTED",
              "CONTRADICTED",
              "UNSUPPORTED",
              "NON_FACTUAL_STYLE"
            ]
          },
          "fact_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "detail": {
            "type": "string"
          },
          "material": {
            "type": "boolean"
          }
        }
      },
      "description": "Каждый SUPPORTED обязан нести fact_id."
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quality_scores": {
      "type": "object"
    },
    "quality_gate_status": {
      "enum": [
        "PASSED",
        "REJECTED",
        "NEEDS_FACTS",
        "FACT_CONFLICT",
        "REVIEW_REQUIRED",
        "OMIT",
        "NOINDEX_RECOMMENDED"
      ]
    },
    "rejection_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^seo-draft-[0-9a-f]{64}$",
      "description": "Считается из site_id + entity_type + entity_id + fact_pack_sha256 + prompt_version + locale. Изменение фактов даёт другой ключ и новую ревизию."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "owner_service": {
      "type": "string"
    },
    "target_environment": {
      "enum": [
        "test",
        "non-production"
      ],
      "description": "Production в этой версии недостижим по устройству."
    },
    "publication_state": {
      "enum": [
        "DRAFT"
      ],
      "description": "Контур не публикует. Других состояний у него нет."
    },
    "lifecycle_state": {
      "type": "string"
    },
    "technical_recommendations": {
      "type": "object",
      "description": "H1, canonical, крошки и JSON-LD об одной и той же сущности."
    }
  }
}
