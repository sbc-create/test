{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://site-factory.local/schemas/secret-hub.schema.json",
  "title": "Реестр направлений Secret Hub",
  "description": "Описание направлений и их потребителей. Схема запрещает хранить здесь значения секретов: ни одно свойство не принимает api_token или publisher_id, а additionalProperties выключены на каждом уровне, поэтому «просто дописать поле со значением» не получится.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "store_dir", "socket_path", "provider", "portfolios"],
  "properties": {
    "version": {"const": 1},
    "note": {"type": "string"},
    "store_dir": {
      "type": "string",
      "pattern": "^/",
      "description": "Каталог зашифрованного хранилища. Обязан быть вне репозитория; проверяется кодом, а не схемой."
    },
    "socket_path": {"type": "string", "pattern": "^/"},
    "control_group": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_-]{0,31}$",
      "description": "Unix-группа, которой разрешено обращаться к сокету управления. Членство в ней не даёт доступа к значениям: API их не возвращает."
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "verify"],
      "properties": {
        "name": {"type": "string", "enum": ["cdnvideohub"]},
        "verify": {
          "type": "object",
          "additionalProperties": false,
          "required": ["base_url", "path", "method", "auth_header", "auth_scheme", "provenance"],
          "properties": {
            "base_url": {"type": "string", "format": "uri", "pattern": "^https://"},
            "path": {"type": "string", "pattern": "^[A-Za-z0-9._~/-]+$"},
            "method": {"const": "GET", "description": "Проверка обязана быть read-only. Схема допускает только GET."},
            "auth_header": {"type": "string", "minLength": 1},
            "auth_scheme": {"type": "string", "minLength": 1},
            "timeout_ms": {"type": "integer", "minimum": 1000, "maximum": 60000},
            "provenance": {"type": "string", "minLength": 20},
            "note": {"type": "string"}
          }
        }
      }
    },
    "portfolios": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/portfolio"}
    }
  },
  "$defs": {
    "portfolio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "enabled", "consumers"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,31}$",
          "description": "Идентификатор направления. Новое направление — новая запись здесь; в коде список направлений не зашит."
        },
        "title": {"type": "string", "minLength": 1},
        "enabled": {"type": "boolean"},
        "blocked_target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason", "required_input"],
          "properties": {
            "status": {"const": "BLOCKED_TARGET"},
            "reason": {"type": "string", "minLength": 10},
            "required_input": {"type": "string", "minLength": 10}
          }
        },
        "consumers": {
          "type": "array",
          "items": {"$ref": "#/$defs/consumer"}
        }
      },
      "allOf": [
        {
          "description": "Направление без потребителей обязано объяснить, почему их нет. Пустой список без blocked_target — это молчаливое «применять некуда», а такие вещи в фабрике не молчат.",
          "if": {"properties": {"consumers": {"maxItems": 0}}, "required": ["consumers"]},
          "then": {"required": ["blocked_target"]}
        },
        {
          "description": "И наоборот: если потребители есть, направление не может числиться заблокированным.",
          "if": {"properties": {"consumers": {"minItems": 1}}, "required": ["consumers"]},
          "then": {"not": {"required": ["blocked_target"]}}
        }
      ]
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "directory", "files", "owner", "group", "file_mode", "directory_mode", "reload"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
        "kind": {"type": "string", "enum": ["file_mount", "systemd_credential"]},
        "title": {"type": "string", "minLength": 1},
        "directory": {"type": "string", "pattern": "^/"},
        "files": {
          "type": "object",
          "additionalProperties": false,
          "required": ["api_token", "publisher_id"],
          "properties": {
            "api_token": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
            "publisher_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}
          },
          "description": "Имена файлов, а не их содержимое."
        },
        "owner": {"const": "root"},
        "group": {"type": "string", "pattern": "^[a-z_][a-z0-9_-]{0,31}$"},
        "file_mode": {
          "type": "string",
          "enum": ["0400", "0600"],
          "description": "Файл секрета читает только владелец. Другие значения схема не принимает."
        },
        "directory_mode": {"type": "string", "enum": ["0700", "0750", "0755"]},
        "unit": {"type": "string", "pattern": "^[A-Za-z0-9@._-]+\\.service$"},
        "dropin": {"type": "string", "pattern": "^/.*\\.conf$"},
        "credential_names": {
          "type": "object",
          "additionalProperties": false,
          "required": ["api_token", "publisher_id"],
          "properties": {
            "api_token": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
            "publisher_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"}
          }
        },
        "compose_file": {"type": "string", "pattern": "^/"},
        "expect_mount_target": {"type": "string", "pattern": "^/"},
        "reload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {"type": "string", "enum": ["none", "systemd"]},
            "note": {"type": "string"}
          }
        }
      },
      "allOf": [
        {
          "description": "Потребитель systemd обязан назвать unit, drop-in и имена credentials: без них применить нечего, а угадывать имя unit'а фабрика не станет.",
          "if": {"properties": {"kind": {"const": "systemd_credential"}}, "required": ["kind"]},
          "then": {"required": ["unit", "dropin", "credential_names"]}
        },
        {
          "description": "Перезапуск unit'а требует знать, какой именно unit перезапускать. Иначе «перезапустить только затронутое направление» проверить невозможно.",
          "if": {"properties": {"reload": {"properties": {"kind": {"const": "systemd"}}, "required": ["kind"]}}, "required": ["reload"]},
          "then": {"required": ["unit"]}
        }
      ]
    }
  }
}
