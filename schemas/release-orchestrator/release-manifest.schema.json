{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://site-factory.local/schemas/release-orchestrator/release-manifest.schema.json",
  "title": "ReleaseManifest",
  "description": "Immutable batch release manifest. After owner approval the digest must not change. No secrets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "owner_approval_id",
    "created_at",
    "expires_at",
    "requested_by",
    "release_mode",
    "canary_site_id",
    "failure_policy",
    "indexability_mutations_allowed",
    "dns_mutations_allowed",
    "paid_operations_allowed",
    "sites"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "release_id": {
      "type": "string",
      "pattern": "^rel-[a-z0-9-]{8,64}$"
    },
    "owner_approval_id": {
      "type": ["string", "null"],
      "description": "Null until approved; after approval must match approval binding."
    },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "requested_by": { "type": "string", "minLength": 1 },
    "release_mode": {
      "type": "string",
      "enum": ["canary_then_serial", "shadow", "dry_run"]
    },
    "canary_site_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,40}$"
    },
    "failure_policy": {
      "type": "string",
      "enum": [
        "ROLLBACK_CURRENT_SITE_AND_STOP_BATCH",
        "ROLLBACK_ALL_ATOMIC"
      ]
    },
    "indexability_mutations_allowed": { "type": "boolean" },
    "dns_mutations_allowed": { "type": "boolean" },
    "paid_operations_allowed": { "type": "boolean" },
    "sites": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "site_id",
          "domain",
          "source_head",
          "artifact_path",
          "artifact_sha256",
          "manifest_sha256",
          "template_profile",
          "expected_design_id",
          "expected_build_id",
          "expected_indexability_before",
          "expected_indexability_after",
          "expected_catalog_revision",
          "expected_details_revision",
          "smoke_profile",
          "rollback_required"
        ],
        "properties": {
          "site_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,40}$"
          },
          "domain": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$"
          },
          "source_head": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "artifact_path": { "type": "string", "minLength": 1 },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "template_profile": { "type": "string", "minLength": 1 },
          "expected_design_id": { "type": "string", "minLength": 1 },
          "expected_build_id": { "type": "string", "minLength": 1 },
          "expected_indexability_before": {
            "type": "string",
            "enum": ["OPEN", "CLOSED"]
          },
          "expected_indexability_after": {
            "type": "string",
            "enum": ["OPEN", "CLOSED"]
          },
          "expected_catalog_revision": { "type": "string", "minLength": 1 },
          "expected_details_revision": { "type": "string", "minLength": 1 },
          "smoke_profile": { "type": "string", "minLength": 1 },
          "rollback_required": { "type": "boolean" }
        }
      }
    }
  }
}
