{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://site-factory.local/schemas/release-orchestrator/site-intake.schema.json",
  "title": "SiteIntakeBatch",
  "description": "Intake for registering draft sites before an immutable release batch. New sites stay CLOSED unless the release manifest explicitly allows OPEN.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sites"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "sites": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "site_id",
          "domain",
          "family",
          "template_profile",
          "desired_indexability",
          "data_source",
          "catalog_source",
          "details_source",
          "player_policy",
          "ratings_policy",
          "content_policy",
          "analytics_policy",
          "seo_policy",
          "owner_config"
        ],
        "properties": {
          "site_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,40}$"
          },
          "domain": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$"
          },
          "family": { "type": "string", "minLength": 1 },
          "template_profile": { "type": "string", "minLength": 1 },
          "desired_indexability": {
            "type": "string",
            "enum": ["OPEN", "CLOSED"]
          },
          "data_source": { "type": "string", "minLength": 1 },
          "catalog_source": { "type": "string", "minLength": 1 },
          "details_source": { "type": "string", "minLength": 1 },
          "player_policy": { "type": "string", "minLength": 1 },
          "ratings_policy": { "type": "string", "minLength": 1 },
          "content_policy": { "type": "string", "minLength": 1 },
          "analytics_policy": { "type": "string", "minLength": 1 },
          "seo_policy": { "type": "string", "minLength": 1 },
          "owner_config": { "type": "object" }
        }
      }
    }
  }
}
