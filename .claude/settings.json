  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_bash.py",
            "timeout": 20,
            "statusMessage": "factory guard: проверка команды"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_write.py",
            "timeout": 20,
            "statusMessage": "factory guard: проверка записи"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pretooluse-guard.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/secret_scan.py",
            "timeout": 30,
            "statusMessage": "factory guard: поиск секретов"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh",
            "timeout": 30
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "disableBypassPermissionsMode": "disable",
  "env": {
    "FACTORY_CLOSED_WORLD": "1",
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "$profile_note": "UNATTENDED_SAFE: обычная разработка идёт без подтверждений. Решение выдают PreToolUse-хуки .claude/hooks/guard_bash.py и guard_write.py поверх профиля seo_operator/unattended.py; правила ниже — второй слой того же решения. deny сильнее любого allow и любого решения хука: список deny не сокращается."
}
