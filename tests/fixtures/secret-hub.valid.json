{
  "version": 1,
  "note": "Фикстура реестра направлений: минимальный корректный документ. Направления вымышленные и намеренно не совпадают с боевыми — фикстура проверяет схему, а не содержимое config/secret-hub.json.",
  "store_dir": "/var/lib/example-secret-hub",
  "socket_path": "/run/example-secret-hub/hub.sock",
  "control_group": "examplehub",
  "provider": {
    "name": "cdnvideohub",
    "verify": {
      "base_url": "https://public-api.cdnvideohub.com/api/v1/",
      "path": "countries",
      "method": "GET",
      "auth_header": "Authorization",
      "auth_scheme": "Bearer",
      "timeout_ms": 15000,
      "provenance": "фикстура: адрес взят из боевого реестра, значения секретов здесь отсутствуют"
    }
  },
  "portfolios": [
    {
      "id": "example-mount",
      "title": "Направление с файловым монтированием",
      "enabled": true,
      "consumers": [
        {
          "id": "example-mount-01",
          "kind": "file_mount",
          "title": "compose-стенд",
          "directory": "/srv/example/runtime/cdnvideohub",
          "files": {
            "api_token": "api-token",
            "publisher_id": "publisher-id"
          },
          "owner": "root",
          "group": "root",
          "file_mode": "0400",
          "directory_mode": "0755",
          "compose_file": "/srv/example/compose.yaml",
          "expect_mount_target": "/run/cdnvideohub",
          "reload": {
            "kind": "none",
            "note": "контейнер читает файл при старте"
          }
        }
      ]
    },
    {
      "id": "example-unit",
      "title": "Направление с systemd LoadCredential",
      "enabled": true,
      "consumers": [
        {
          "id": "example-unit-01",
          "kind": "systemd_credential",
          "title": "example-unit-01.service",
          "unit": "example-unit-01.service",
          "directory": "/etc/example/secrets/unit-01",
          "files": {
            "api_token": "cdnvideohub-api-token",
            "publisher_id": "cdnvideohub-publisher-id"
          },
          "owner": "root",
          "group": "root",
          "file_mode": "0400",
          "directory_mode": "0700",
          "dropin": "/etc/systemd/system/example-unit-01.service.d/10-cdnvideohub-credentials.conf",
          "credential_names": {
            "api_token": "cdnvideohub_api_token",
            "publisher_id": "cdnvideohub_publisher_id"
          },
          "reload": {
            "kind": "systemd",
            "note": "перезапускается только этот unit"
          }
        }
      ]
    },
    {
      "id": "example-blocked",
      "title": "Направление без переданной инфраструктуры",
      "enabled": true,
      "blocked_target": {
        "status": "BLOCKED_TARGET",
        "reason": "Инфраструктура направления не передана: применять credentials некуда.",
        "required_input": "Каталог развёртывания или список unit'ов направления."
      },
      "consumers": []
    }
  ]
}
