#!/usr/bin/env python3
"""Публичная почта обратной связи витрины: есть, та самая, и проведена в рантайм.

Зачем проверка в пути выпуска
-----------------------------

Опрос сети 2026-10-01 нашёл три разных состояния одновременно: на части витрин
стоял прежний адрес, на yummyani.org и yummyani.site адреса не было ВОВСЕ, а
конфигурация при этом везде выглядела заполненной. То есть «значение лежит в
config/site.json» и «посетитель видит адрес» — разные утверждения, и первое
проверяется здесь, до выпуска.

Ровно так же однажды вышло с проводкой: `contact_email` стоял, строка подвала
стояла, а `run.py` переменную не выставлял — подвал вышел бы пустым на каждой
странице при зелёных проверках. Поэтому проверяется не наличие поля, а ЦЕПОЧКА:
значение -> переменная окружения -> отсутствие прежнего адреса в репозитории.

Чего проверка НЕ делает
-----------------------

Не подтверждает доставку писем: правильная ссылка и дошедшее письмо — разные
утверждения, второе проверяет живой человек. И не заменяет опрос выложенной
страницы: исходники могут быть верны, а выложен прежний релиз.
"""
from __future__ import annotations

import ast
import json
import sys
from pathlib import Path

КОРЕНЬ = Path(__file__).resolve().parent.parent

#: Адрес сети. Копия значения из factory/contact.py::ПОЧТА_СЕТИ — репозиторий
#: витрины отдельный и импортировать фабрику не может. Чтобы копии не
#: разошлись, их совпадение сторожит
#: tests/unit/test_contact_email_single_source.py в фабрике.
ОЖИДАЕТСЯ = "@@АДРЕС@@"

#: Прежний адрес. Назван, чтобы проверка умела сказать, ЧЕГО не должно быть.
ПРЕЖНИЙ = "sbc.claude@yandex.ru"

#: Файлы, которым разрешено упоминать прежний адрес: сама эта проверка.
СВОИ = {Path(__file__).resolve()}


#: Имена, связанные конструкциями Python, а не присваиванием: параметр
#: функции — такое же связывание, как `=`, и считать его неопределённым
#: значит падать на верном коде.
def _связанные(узел) -> set:
    """Имена, связанные В ЭТОЙ области видимости."""
    имена: set = set()
    если_функция = isinstance(узел, (ast.FunctionDef, ast.AsyncFunctionDef))
    if если_функция:
        арг = узел.args
        for список in (арг.posonlyargs, арг.args, арг.kwonlyargs):
            имена.update(а.arg for а in список)
        for одиночный in (арг.vararg, арг.kwarg):
            if одиночный is not None:
                имена.add(одиночный.arg)
    for вложенный in ast.walk(узел):
        if если_функция and вложенный is not узел and isinstance(
                вложенный, (ast.FunctionDef, ast.AsyncFunctionDef, ast.Lambda)):
            continue
        if isinstance(вложенный, ast.Name) and isinstance(вложенный.ctx, ast.Store):
            имена.add(вложенный.id)
        elif isinstance(вложенный, (ast.FunctionDef, ast.AsyncFunctionDef,
                                    ast.ClassDef)):
            имена.add(вложенный.name)
        elif isinstance(вложенный, (ast.Import, ast.ImportFrom)):
            for псевдоним in вложенный.names:
                имена.add((псевдоним.asname or псевдоним.name).split(".")[0])
    return имена


def _проводка_run(текст: str) -> list:
    """Две беды, обе наблюдались, и обе невидимы для `py_compile`.

    1. У имени спрашивают `contact_email`, а имя не связано — `NameError` на
       запуске. Проверяется по дереву, а не регулярным выражением: параметр
       функции связывает имя не хуже присваивания, и прежняя проверка по
       тексту объявляла ошибкой верный код.
    2. Переменная выставляется ПОСЛЕ раннего возврата `--check` — тогда
       проверка конфигурации этих строк не исполняет. Порядок берётся по
       порядку ОПЕРАТОРОВ в `main`, а не по номерам строк в файле: вызов
       функции, определённой ниже, стоит в исполнении выше её определения.
    """
    беды: list = []
    try:
        дерево = ast.parse(текст)
    except SyntaxError as ошибка:
        return [f"run.py не разбирается: {ошибка}"]

    модульные = _связанные(дерево)
    области = {}  # узел функции -> множество связанных имён
    родитель = {}
    for узел in ast.walk(дерево):
        if isinstance(узел, (ast.FunctionDef, ast.AsyncFunctionDef)):
            области[узел] = _связанные(узел)
        for ребёнок in ast.iter_child_nodes(узел):
            родитель[ребёнок] = узел

    def цепочка(узел) -> list:
        """Функции, охватывающие узел, от ближней к дальней."""
        итог = []
        текущий = родитель.get(узел)
        while текущий is not None:
            if isinstance(текущий, (ast.FunctionDef, ast.AsyncFunctionDef)):
                итог.append(текущий)
            текущий = родитель.get(текущий)
        return итог

    for узел in ast.walk(дерево):
        if not (isinstance(узел, ast.Call)
                and isinstance(узел.func, ast.Attribute)
                and узел.func.attr == "get"
                and узел.args
                and isinstance(узел.args[0], ast.Constant)
                and узел.args[0].value == "contact_email"
                and isinstance(узел.func.value, ast.Name)):
            continue
        имя = узел.func.value.id
        видно = set(модульные)
        for охват in цепочка(узел):
            видно |= области.get(охват, set())
        if имя not in видно:
            беды.append(f"run.py спрашивает {имя}.get('contact_email'), а имя "
                        f"{имя!r} не связано — NameError при запуске, который "
                        "py_compile не видит")

    # Кто вообще выставляет переменную: сама строка или функция, в теле
    # которой она выставляется.
    выставляют = set()
    for узел in дерево.body:
        if isinstance(узел, (ast.FunctionDef, ast.AsyncFunctionDef)):
            if "SITE_CONTACT_EMAIL" in (ast.get_source_segment(текст, узел) or ""):
                выставляют.add(узел.name)
    главная = next((у for у in дерево.body
                    if isinstance(у, (ast.FunctionDef, ast.AsyncFunctionDef))
                    and у.name == "main"), None)
    if главная is None:
        return беды
    где_ставят = где_проверка = None
    for номер, оператор in enumerate(главная.body):
        отрывок = ast.get_source_segment(текст, оператор) or ""
        ставит = "SITE_CONTACT_EMAIL" in отрывок or any(
            isinstance(в, ast.Name) and в.id in выставляют
            for в in ast.walk(оператор))
        if ставит and где_ставят is None:
            где_ставят = номер
        if (где_проверка is None and isinstance(оператор, ast.If)
                and "check" in (ast.get_source_segment(текст, оператор.test) or "")
                and any(isinstance(в, ast.Return) for в in ast.walk(оператор))):
            где_проверка = номер
    if где_ставят is None:
        беды.append("в main() нет ни строки, ни вызова, выставляющих "
                    "SITE_CONTACT_EMAIL")
    elif где_проверка is not None and где_ставят > где_проверка:
        беды.append("выставление SITE_CONTACT_EMAIL стоит ПОСЛЕ раннего "
                    "возврата --check: проверка конфигурации его не исполнит")
    return беды


def беды() -> list[str]:
    итог: list[str] = []

    конфиг = КОРЕНЬ / "config" / "site.json"
    if not конфиг.is_file():
        return [f"нет {конфиг}"]
    данные = json.loads(конфиг.read_text(encoding="utf-8"))
    адрес = str(данные.get("contact_email") or "").strip()

    if not адрес:
        итог.append("config/site.json: contact_email пуст — это BLOCKED_INPUT, "
                    "а не умолчание: подвал выйдет без строки обратной связи")
    elif адрес == ПРЕЖНИЙ:
        итог.append(f"config/site.json: contact_email всё ещё прежний ({ПРЕЖНИЙ}), "
                    f"ожидается {ОЖИДАЕТСЯ}")
    elif адрес != ОЖИДАЕТСЯ:
        итог.append(f"config/site.json: contact_email {адрес!r}, "
                    f"а у сети {ОЖИДАЕТСЯ!r}. Свой адрес на отдельной витрине — "
                    "потерянные письма, а не гибкость")
    if адрес and ("@" not in адрес or " " in адрес or адрес.count("@") != 1):
        итог.append(f"config/site.json: contact_email {адрес!r} не похож на адрес")

    # Проводка: кто читает переменную, тот должен её и получать.
    run = КОРЕНЬ / "run.py"
    рантаймы = list((КОРЕНЬ / "src").glob("*frontend*.py")) if (КОРЕНЬ / "src").is_dir() else []
    читают = [п for п in рантаймы
              if "SITE_CONTACT_EMAIL" in п.read_text(encoding="utf-8", errors="replace")]
    if читают and run.is_file():
        текст = run.read_text(encoding="utf-8")
        if "SITE_CONTACT_EMAIL" not in текст:
            итог.append(f"{читают[0].name} читает SITE_CONTACT_EMAIL, а run.py её не "
                        "выставляет — строка обратной связи выйдет пустой")
        elif "contact_email" not in текст:
            итог.append("run.py выставляет SITE_CONTACT_EMAIL не из config/site.json")
        else:
            итог.extend(_проводка_run(текст))

    # Прежнего адреса в репозитории не осталось.
    for путь in КОРЕНЬ.rglob("*"):
        if not путь.is_file() or путь.resolve() in СВОИ:
            continue
        if any(ч in путь.parts for ч in ("__pycache__", ".git", "node_modules")):
            continue
        if путь.suffix not in {".py", ".json", ".md", ".html", ".css", ".js", ".sh", ".yaml", ".yml"}:
            continue
        try:
            текст = путь.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        if ПРЕЖНИЙ in текст:
            итог.append(f"{путь.relative_to(КОРЕНЬ)}: остался прежний адрес {ПРЕЖНИЙ}")
    return итог


def main() -> int:
    плохо = беды()
    for б in плохо:
        print(f"  — {б}", file=sys.stderr)
    return 1 if плохо else 0


if __name__ == "__main__":
    raise SystemExit(main())
