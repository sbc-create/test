+def превью_с_постерами(набор: list[dict], предел: int) -> list[dict]:
+    """Первые `предел` записей, предпочитая те, у которых ЕСТЬ постер.
+
+    Полка — визуальное обещание: карточка-заглушка на главной читается
+    посетителем как сломанный сайт. Измерено 20.10 на zonafilm.space: в полке
+    «Высокие оценки недели» шесть карточек из 24 шли заглушкой, и страница
+    произведения показывает заглушку тоже — то есть постера у записи нет вовсе,
+    и это пробел ДАННЫХ, который правится отдельно.
+
+    Почему это не обеднит полку, и это измерено: в каталоге zona-01 без постера
+    841 запись из 67 681 (1.24 %), среди записей с оценкой не ниже порога
+    высокой — 117 из 8 406 (1.39 %). Кандидатов на полку из 24 карточек
+    остаётся 8 289.
+
+    Чего функция НЕ делает:
+
+    * не выбрасывает записи из ПОЛНОЙ страницы подборки — та поверхность
+      каталога, и терять в ней высокую оценку из-за картинки нельзя;
+    * не оставляет полку короче: при нехватке постеров остаток добирается
+      записями без них. Пустая полка хуже заглушки;
+    * не меняет порядок внутри каждой из двух групп.
+    """
+    если_есть = [з for з in набор if str(з.get("poster") or "").strip()]
+    if len(если_есть) >= предел:
+        return если_есть[:предел]
+    без = [з for з in набор if not str(з.get("poster") or "").strip()]
+    return (если_есть + без)[:предел]
+
+
 def разрешить(ключ: str, снимок: Снимок, семейство: str, *,
               предел: int | None = None, страница: int = 1,
               на_странице: int = 60) -> Коллекция | None:
