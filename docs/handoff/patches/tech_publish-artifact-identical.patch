+def файлы_артефакта(репо: Path, коммит: str) -> list[str]:
+    """Пути артефакта в дереве коммита. Пустой список — сравнивать нечем."""
+    г = _git(репо, "ls-tree", "-r", "--name-only", коммит)
+    if г.returncode != 0:
+        return []
+    пути = [п.strip() for п in (г.stdout or "").splitlines() if п.strip()]
+    итог = [п for п in пути
+            if п in ФАЙЛЫ_АРТЕФАКТА
+            or (п.startswith(КАТАЛОГ_АРТЕФАКТА) and п.endswith(".py"))]
+    return sorted(итог)
+
+
+def цифра_дерева(репо: Path, коммит: str) -> tuple[str, str]:
+    """(sha256 артефакта в этом коммите, причина пустоты).
+
+    Рамка та же, что у рантайма (D207): имя, NUL, байты, NUL, по
+    отсортированным именам. Побайтно — то есть содержимое файлов, а не список
+    изменённых путей: по списку путей «совпадает» можно получить и там, где
+    содержимое разное.
+    """
+    пути = файлы_артефакта(репо, коммит)
+    if not пути:
+        return "", f"в дереве {коммит[:12]} нет файлов артефакта"
+    сумма = hashlib.sha256()
+    for путь in пути:
+        г = subprocess.run(["git", "-C", str(репо), "show", f"{коммит}:{путь}"],
+                           capture_output=True, timeout=600)
+        if г.returncode != 0:
+            return "", f"файл {путь} не прочитан в {коммит[:12]}"
+        сумма.update(путь.encode("utf-8"))
+        сумма.update(b"\0")
+        сумма.update(г.stdout)
+        сумма.update(b"\0")
+    return сумма.hexdigest(), ""
+
+
+def сравнить_артефакты(репо: Path, head: str, live: str) -> dict:
+    """Факты для правила «выпуск не нужен».
+
+    Три исхода, и третий обязателен: если сравнить НЕ УДАЛОСЬ, правило не
+    применяется и остаётся прежнее ожидание. Тихого «совпадает» быть не
+    должно — иначе правило станет способом пропускать выпуски молча.
+    """
+    if not head or not live:
+        return {"artifact_same": None, "artifact_reason": "нет головы или живого коммита"}
+    ц_head, беда_head = цифра_дерева(репо, head)
+    ц_live, беда_live = цифра_дерева(репо, live)
+    if беда_head or беда_live:
+        return {"artifact_same": None, "artifact_head": ц_head or "",
+                "artifact_live": ц_live or "",
+                "artifact_reason": беда_head or беда_live}
+    return {"artifact_same": ц_head == ц_live, "artifact_head": ц_head,
+            "artifact_live": ц_live,
+            "artifact_reason": "" if ц_head == ц_live
+            else "артефакты различаются"}
+
