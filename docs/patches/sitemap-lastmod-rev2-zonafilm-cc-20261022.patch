+def _сейчас_utc() -> str:
+    """Текущий момент UTC в ISO 8601 с `Z`. Отдельной функцией — для подмены в тесте."""
+    import datetime as _dt
+
+    return (_dt.datetime.now(_dt.timezone.utc).replace(microsecond=0)
+            .isoformat().replace("+00:00", "Z"))
+
