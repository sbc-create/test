{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seo/learning/EXPERIMENT_SCHEMA.json",
  "title": "Experiment",
  "type": "object",
  "required": ["id", "site_id", "hypothesis", "evidence", "primary_variable", "primary_kpi",
               "baseline_start", "baseline_end", "guardrails", "stop_loss", "min_sample",
               "rollback_payload", "before_snapshot", "status"],
  "properties": {
    "id": {"type": "string", "pattern": "^EXP-\\d{8}-[a-z0-9-]+-\\d{3}$"},
    "site_id": {"type": "string"},
    "page_type": {"type": ["string", "null"]},
    "query_cohort": {"type": ["string", "null"]},
    "hypothesis": {"type": "string", "minLength": 10},
    "evidence": {"type": "string", "minLength": 10},
    "primary_variable": {"type": "string",
                         "description": "Ровно одна переменная. Побочные изменения только с префиксом inseparable:."},
    "secondary_changes": {"type": "array", "items": {"type": "string", "pattern": "^inseparable:"}},
    "baseline_start": {"type": "string", "format": "date"},
    "baseline_end": {"type": "string", "format": "date"},
    "control_cohort": {"type": ["string", "null"]},
    "started_at": {"type": ["string", "null"]},
    "ends_at": {"type": ["string", "null"]},
    "primary_kpi": {"type": "string"},
    "guardrails": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "min_sample": {"type": "object"},
    "stop_loss": {"type": "object", "minProperties": 1},
    "rollback_payload": {"type": "object", "required": ["executable"],
                         "properties": {"executable": {"const": true}}},
    "before_snapshot": {"type": "object"},
    "audit_refs": {"type": "array", "items": {"type": ["string", "integer"]}},
    "status": {"enum": ["draft", "running", "observing", "mature", "kept",
                        "rolled_back", "inconclusive", "frozen"]},
    "result": {"type": ["object", "null"]},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "confounders": {"type": "array", "items": {"type": "string"}},
    "decision": {"enum": ["keep", "rollback", "inconclusive", "iterate", null]},
    "learned_rule_candidate": {"type": ["string", "null"]}
  }
}
