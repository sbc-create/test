#!/usr/bin/env bash
# Единая точка запуска установки Secret Hub.
#
#     sudo /srv/site-factory/repo/bin/secret-hub-install
#     sudo /srv/site-factory/repo/bin/secret-hub-install --preflight   # ничего не меняет
#
# Почему здесь, а не в var/
# -------------------------
# Прежний лончер лежал в `var/install-secret-hub.sh` и однажды просто
# отсутствовал на хосте: «No such file or directory» при запуске из корня
# репозитория. Причин две, и обе системные:
#
#   1. `var/` — рабочий каталог фабрики (locks, build, backups, artifacts). Его
#      содержимое меняется на каждом прогоне, и версионируемому скрипту там не
#      место. В git он попадал через исключение `!var/...` поверх `var/*` —
#      конструкцию, которая работает ровно до первой неожиданности.
#   2. Рабочая копия /srv/site-factory/repo общая: ветки в ней переключают
#      несколько параллельных сессий. На ветках, созданных до появления
#      Secret Hub, лончера нет вовсе — и в момент переключения он исчезает из
#      рабочего дерева.
#
# `bin/` и `automation/` отслеживаются, лежат вне рабочего каталога и меняются
# только вместе с кодом. Путь до репозитория вычисляется от расположения самого
# файла, поэтому лончер работает из любого каталога и при любом способе вызова.
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
REPO="$(dirname "$(dirname "$SELF")")"
exec bash "$REPO/automation/secret-hub/install-secret-hub.sh" "$@"
