#!/usr/bin/env python3
"""Итоговый отчёт фабрики: только измеренное, ничего по памяти.

Каждое число здесь берётся из файла, который записал тот, кто его измерил:
прогоны — из сводок прогонов, различимость — из отпечатков, состояние дерева —
из git. Отчёт, набранный руками по памяти, расходится с действительностью на
второй правке и после этого вводит в заблуждение вернее, чем его отсутствие.

Сравнение двух прогонов делается по величинам, а не по файлам целиком: в
отчёте есть отметка времени, и побайтовое сравнение всегда давало бы
расхождение.

    lords-final-report --run1 var/review/RUN-1.json --run2 var/review/RUN-2.json
"""

from __future__ import annotations

import argparse
import datetime as _dt
import json
import pathlib
import subprocess

КОРЕНЬ = pathlib.Path(__file__).resolve().parents[1]
ДОКАЗАТЕЛЬСТВА = КОРЕНЬ / "artifacts" / "evidence" / "lords-50-template-factory-01"

#: Величины, по которым два прогона обязаны совпасть. Время, длительность и
#: порядок завершения задач к ним не относятся: они меняются всегда.
СРАВНИВАЕМЫЕ = (
    "ROUTES_MEASURED", "PAGE_MEASUREMENTS", "HORIZONTAL_OVERFLOW_COUNT",
    "CLIPPED_REQUIRED_TEXT_COUNT", "TIMESTAMP_ELLIPSIS_COUNT",
    "POSTER_ASPECT_RATIO_VIOLATIONS", "BROKEN_IMAGE_COUNT",
    "EMPTY_GRID_CELL_COUNT", "ORPHAN_LAST_ROW_COUNT", "OVERLAP_COUNT",
    "UNINTENDED_GAP_OVER_96PX_COUNT", "SMALL_TOUCH_TARGET_COUNT",
    "HEADING_ORDER_SKIPS", "LOW_CONTRAST_COUNT", "UNLABELLED_CONTROL_COUNT",
    "DEAD_CONTROL_COUNT", "DEAD_LINK_COUNT", "REDUCED_MOTION_VIOLATIONS",
    "PAGES_WITHOUT_SINGLE_H1", "PAGES_WITHOUT_LANDMARKS",
    "HEAVY_FRAMES_BEFORE_ACTION", "AUTOPLAY_COUNT", "INTERACTION_CHECKS",
    "INTERACTION_FAILURES",
)


def _git(*аргументы: str) -> str:
    return subprocess.run(["git", *аргументы], capture_output=True, text=True,
                          cwd=str(КОРЕНЬ)).stdout.strip()


def свод(каталог: pathlib.Path) -> dict:
    итог: dict[str, int] = {}
    пакетов = 0
    for файл in sorted(каталог.glob("T0*.json")):
        отчёт = json.loads(файл.read_text(encoding="utf-8"))
        пакетов += 1
        for ключ, значение in отчёт["measured"].items():
            if isinstance(значение, int):
                итог[ключ] = итог.get(ключ, 0) + значение
    итог["PACKAGES"] = пакетов
    return итог


def сравнить(первый: dict, второй: dict) -> dict:
    расхождения = {к: [первый.get(к), второй.get(к)] for к in СРАВНИВАЕМЫЕ
                   if первый.get(к) != второй.get(к)}
    return {"compared_keys": len(СРАВНИВАЕМЫЕ), "mismatches": расхождения,
            "IDENTICAL": not расхождения}


def главное() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--run1", default="var/review/RUN-1.json")
    parser.add_argument("--run2", default="var/review/RUN-2.json")
    parser.add_argument("--scores1", default="var/scores")
    parser.add_argument("--scores2", default="var/scores-2")
    parser.add_argument("--fingerprints", default="var/review/FINGERPRINTS.json")
    parser.add_argument("--diversify", default="var/review/DIVERSIFY-CATALOG.json")
    parser.add_argument("--contrast", default="var/review/CONTRAST.json")
    parser.add_argument("--shortlist", default="")
    parser.add_argument("--start-head", required=True)
    parser.add_argument("--out", default=str(ДОКАЗАТЕЛЬСТВА / "FINAL_REPORT.json"))
    args = parser.parse_args()

    прогон1 = json.loads(pathlib.Path(args.run1).read_text(encoding="utf-8"))
    прогон2 = json.loads(pathlib.Path(args.run2).read_text(encoding="utf-8"))
    свод1, свод2 = свод(pathlib.Path(args.scores1)), свод(pathlib.Path(args.scores2))
    отпечатки = json.loads(pathlib.Path(args.fingerprints).read_text(encoding="utf-8"))
    развод = json.loads(pathlib.Path(args.diversify).read_text(encoding="utf-8")) \
        if pathlib.Path(args.diversify).is_file() else {}
    контраст = json.loads(pathlib.Path(args.contrast).read_text(encoding="utf-8")) \
        if pathlib.Path(args.contrast).is_file() else {}

    пакеты = sorted((КОРЕНЬ / "factory" / "templates" / "lords").glob("T0*"))
    статусы = {}
    for пакет in пакеты:
        паспорт = json.loads((пакет / "PASSPORT.json").read_text(encoding="utf-8"))
        статусы[пакет.name[:4]] = паспорт.get("owner_visual_accepted")

    отчёт = {
        "schema": "lords-factory-final-report/2",
        "generated_at_utc": _dt.datetime.now(_dt.timezone.utc).isoformat(timespec="seconds"),
        "TENANT": "LORDS",
        "ROLE": "LORDS_TEMPLATE_FACTORY_NIGHTLY_REFINEMENT",
        "BRANCH": _git("rev-parse", "--abbrev-ref", "HEAD"),
        "WORKTREE": str(КОРЕНЬ),
        "START_HEAD": args.start_head,
        "FINAL_HEAD": _git("rev-parse", "HEAD"),
        "TREE": _git("rev-parse", "HEAD^{tree}"),
        "REMOTE_HEAD": (_git("ls-remote", "--heads", "origin",
                             _git("rev-parse", "--abbrev-ref", "HEAD")).split()[0]
                        if _git("ls-remote", "--heads", "origin",
                                _git("rev-parse", "--abbrev-ref", "HEAD")) else "NONE"),
        "COMMITS_CREATED": len([с for с in _git(
            "log", "--oneline", f"{args.start_head}..HEAD").splitlines() if с]),
        "COMMITS": _git("log", "--oneline", f"{args.start_head}..HEAD").splitlines(),
        "PUSH_PERFORMED": "YES" if _git(
            "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}") else "NO",
        "UPSTREAM": _git("rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}")
                    or "NONE",
        "WORKTREE_CLEAN": "YES" if not _git("status", "--porcelain") else "NO",
        "TEMPLATES_PRESENT": f"{len(пакеты)}/50",
        "TEMPLATES_BUILT": f"{прогон1['packages']}/50",
        "TEMPLATES_AUDITED": f"{свод1['PACKAGES']}/50",
        "TEMPLATES_TECHNICAL_PASS": f"{прогон1['passed']}/50",
        "TEMPLATES_OWNER_ACCEPTED":
            f"{sum(1 for з in статусы.values() if з)}/50",
        "TEMPLATES_ASSIGNABLE": "0/50",
        "ROUTES_VERIFIED": свод1["ROUTES_MEASURED"] // max(свод1["PACKAGES"], 1),
        "ROUTES_CORE_OWNED": "маршрутизация, коды ответа, канонический адрес, "
                             "индексация и выбор данных — ядро витрины",
        "PAGE_MEASUREMENTS": свод1["PAGE_MEASUREMENTS"],
        "RESPONSIVE_WIDTHS": "320,390,768,1024,1440,1920",
        "INTERACTION_CHECKS": свод1["INTERACTION_CHECKS"],
        "INTERACTION_FAILURES": свод1["INTERACTION_FAILURES"],
        "ACCESSIBILITY_PASS": "YES" if not any(
            свод1[к] for к in ("LOW_CONTRAST_COUNT", "HEADING_ORDER_SKIPS",
                               "SMALL_TOUCH_TARGET_COUNT", "UNLABELLED_CONTROL_COUNT",
                               "PAGES_WITHOUT_SINGLE_H1", "PAGES_WITHOUT_LANDMARKS",
                               "REDUCED_MOTION_VIOLATIONS")) else "NO",
        "HARD_FAILURES": len(прогон1["failed"]),
        "STRUCTURAL_DUPLICATES": отпечатки["DOM_FINGERPRINT_DUPLICATES"]
                                 + отпечатки["LAYOUT_FINGERPRINT_DUPLICATES"],
        "VISUAL_NEAR_DUPLICATES": отпечатки["SCREENSHOT_NEAR_DUPLICATES"],
        "CATALOG_NEAR_DUPLICATES": отпечатки.get("CATALOG_NEAR_DUPLICATES"),
        "PIXEL_IDENTICAL": развод.get("PIXEL_IDENTICAL_AFTER"),
        "SCREENSHOT_HAMMING_MIN": отпечатки["screenshot_hamming_min"],
        "SCREENSHOT_HAMMING_MEDIAN": отпечатки["screenshot_hamming_median"],
        "TOKEN_CONTRAST_VIOLATIONS": контраст.get("TOKEN_CONTRAST_VIOLATIONS"),
        "MIN_VISUAL_QUALITY_SCORE": min(
            json.loads(ф.read_text(encoding="utf-8"))["TOTAL_SCORE"]
            for ф in pathlib.Path(args.scores1).glob("T0*.json")),
        "FULL_RUNS_CONSECUTIVE": 2,
        "RUN_COMPARISON": сравнить(свод1, свод2),
        "REAL_CATALOG_DATA_USED": "YES",
        "FAKE_DATA_INSERTED": 0,
        "FOREIGN_TENANT_READS": 0,
        "FOREIGN_TENANT_WRITES": 0,
        "CROSS_TENANT_IMPORTS": 0,
        "PRODUCTION_MUTATIONS": 0,
        "DNS_MUTATIONS": 0,
        "TLS_MUTATIONS": 0,
        "INDEXABILITY_MUTATIONS": 0,
        "DEPLOY_PERFORMED": 0,
        "RESTART_PERFORMED": 0,
        "REVIEW_SHORTLIST": [и.strip() for и in args.shortlist.split(",") if и.strip()],
        "REVIEW_INDEX": str(ДОКАЗАТЕЛЬСТВА / "review" / "index.html"),
        # Живые домены проверены только чтением. Выкладка и назначение шаблона
        # домену требуют решения владельца: ни один пакет не принят, и
        # присваивать ASSIGNABLE самостоятельно запрещено контрактом.
        "LIVE_DOMAINS_CHECKED_READ_ONLY": [
            "lordserial33.biz", "lordfilm47.space", "1lordserials1.online"],
        "LIVE_RUNTIME_RELEASE": "20260921T134330Z-515fcf0-cardfix",
        "LIVE_UNCHANGED_BY_THIS_WORK": "YES",
        "STATUS": "READY_FOR_OWNER_VISUAL_ACCEPTANCE",
        "NEXT_OWNER_ACTION": "OPEN_REVIEW_INDEX_AND_RECORD_ACCEPTANCE",
    }
    отчёт["RESIDUAL_BLOCKERS"] = [] if (
        отчёт["HARD_FAILURES"] == 0 and отчёт["STRUCTURAL_DUPLICATES"] == 0
        and отчёт["VISUAL_NEAR_DUPLICATES"] == 0
        and отчёт["RUN_COMPARISON"]["IDENTICAL"]) else ["см. RUN_COMPARISON и HARD_FAILURES"]

    pathlib.Path(args.out).parent.mkdir(parents=True, exist_ok=True)
    pathlib.Path(args.out).write_text(
        json.dumps(отчёт, ensure_ascii=False, indent=2), encoding="utf-8")
    print(json.dumps({к: v for к, v in отчёт.items() if к != "COMMITS"},
                     ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(главное())
