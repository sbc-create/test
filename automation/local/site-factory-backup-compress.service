[Unit]
Description=Verify and compress old daily publish backups
ConditionPathIsDirectory=/srv/site-factory/repo/var/lords/publish-backups

[Service]
Type=oneshot
User=claude
Group=claude
ExecStart=/usr/bin/python3 /usr/local/lib/site-factory/backup-compress.py --apply
TimeoutStartSec=1800
Nice=15
CPUQuota=50%
MemoryMax=128M
MemorySwapMax=0
IOWeight=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/site-factory/repo/var/lords/publish-backups
