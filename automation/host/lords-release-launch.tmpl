#!/bin/bash
# Установка и запуск выкладки Lords в отдельном systemd-юните.
#
# Запускается от root, работает секунды и завершается сразу: сама выкладка
# продолжается в юните и переживает закрытый терминал. Ждать в открытом SSH не
# требуется — итог остаётся в файлах.
#
# Кандидат:  f8f20dde0efb24e58f239c8e662cdbb5f0bf2bcf
# Отпечаток: a0cfaf7135255d62e70432162cadc554c393c2c01dec3936baddafd8ca694859
#
# Дефект LORDS-RELEASE-INVOCATION-REUSE-32 исправлен: запуск юнита
# доказывается новой непустой InvocationID во время работы, а не сравнением
# пустых значений после выгрузки юнита.
set -Eeuo pipefail

SITE="${1:-lords-02}"

if [ "$(id -u)" != "0" ]; then
  echo "запускает root"
  exit 1
fi

STAMP="$(date -u +%Y%m%d-%H%M%S)"
UNIT="lords-release-${SITE}-${STAMP}"
LIB=/run/lords-unit-launch.sh
RUNNER=/run/lords-release-runner.sh
VERDICT="/run/${SITE}-release.verdict"
REPORT="/var/log/site-factory/${SITE}-release-report.json"

rm -f "${VERDICT}" "${REPORT}"

cat > "${LIB}" <<'LIB_EOF'
@@LIB@@
LIB_EOF

cat > "${RUNNER}" <<'RUNNER_EOF'
@@RUNNER@@
RUNNER_EOF

chmod 0700 "${LIB}" "${RUNNER}"

if ! systemd-run --unit="${UNIT}" --service-type=oneshot --no-block --collect \
     --property=TimeoutStartSec=32400 --property=KillMode=mixed \
     --property=StandardOutput=journal --property=StandardError=journal \
     --setenv=LAUNCH_LIB="${LIB}" \
     /bin/bash "${RUNNER}" "${SITE}" >/dev/null; then
  echo "юнит ${UNIT} не запустился; витрина не тронута"
  exit 1
fi

echo "выкладка ${SITE} идёт в юните ${UNIT}"
echo "терминал можно закрыть: юнит переживёт разрыв SSH"
echo
echo "итог:   ${VERDICT}"
echo "отчёт:  ${REPORT}"
echo "журнал: journalctl -u ${UNIT} -f -o cat"
