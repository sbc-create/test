+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+// B016: the sitemap inventory must be served from cache even when stale, be
+// rebuilt in the background by one worker, and never block a request behind a
+// full catalog walk unless nothing has ever been stored.
+
+const store = new Map<string, string>();
+const redis = {
+  get: vi.fn(async (key: string) => store.get(key) ?? null),
+  set: vi.fn(async (key: string, value: string, opts?: { NX?: boolean }) => {
+    if (opts?.NX && store.has(key)) return null;
+    store.set(key, value);
+    return "OK";
+  }),
+  del: vi.fn(async (key: string) => (store.delete(key) ? 1 : 0)),
+};
+vi.mock("@/lib/redis", () => ({ getRedis: async () => redis }));
+vi.mock("@/lib/logger", () => ({ log: vi.fn() }));
+
+let walkCalls = 0;
+let releaseWalk: () => void = () => {};
+let walkGate: Promise<void> = Promise.resolve();
+const title = (slug: string) => ({ slug, title: slug, updatedAt: "2026-10-01T00:00:00Z" });
+vi.mock("@/modules/catalog/catalog-query", () => ({
+  walkAnimeCatalogList: vi.fn(async () => {
+    walkCalls += 1;
+    await walkGate;
+    return [title("a"), title("b")];
+  }),
+  getCatalogTitle: vi.fn(async () => null),
+}));
+vi.mock("@/lib/seo/sitemap-inventory", () => ({
+  emptySitemapInventory: () => ({ titles: [], seasons: [], episodes: [], images: [] }),
+  inventoryFromTitles: (titles: { slug: string }[]) => ({
+    titles: titles.map((t) => ({ path: `/anime/${t.slug}`, lastModified: new Date(0), images: [] })),
+    seasons: [],
+    episodes: [],
+    images: [],
+  }),
+}));
+vi.mock("@/lib/seo/copy", () => ({ SEO_CONTENT_UPDATED_AT: "2026-10-01T00:00:00Z" }));
+
+const KEY = "seo:sitemap-inventory:v4-anime";
+const FRESH = `${KEY}:fresh`;
+const LOCK = `${KEY}:lock`;
+const stored = { titles: [{ path: "/anime/old", lastModified: new Date(0).toISOString(), images: [] }], seasons: [], episodes: [], images: [] };
+
+async function load() {
+  const mod = await import("@/lib/seo/sitemap-catalog");
+  return mod;
+}
+
+describe("sitemap inventory cache (B016)", () => {
+  beforeEach(async () => {
+    store.clear();
+    walkCalls = 0;
+    walkGate = Promise.resolve();
+    vi.clearAllMocks();
+    (await load()).__resetSitemapInventoryForTests();
+  });
+
+  it("serves a stale inventory immediately and refreshes it once in the background", async () => {
+    store.set(KEY, JSON.stringify(stored)); // no FRESH marker → stale
+    walkGate = new Promise((resolve) => (releaseWalk = resolve));
+    const { loadSitemapInventory } = await load();
+    const results = await Promise.all([loadSitemapInventory(), loadSitemapInventory(), loadSitemapInventory()]);
+    // All three answered from the stale copy without waiting for the walk.
+    for (const r of results) expect(r.titles.map((t) => t.path)).toEqual(["/anime/old"]);
+    expect(walkCalls).toBe(1); // one background rebuild, not three
+    releaseWalk();
+    await vi.waitFor(() => expect(store.has(FRESH)).toBe(true));
+    expect(JSON.parse(store.get(KEY)!).titles.map((t: { path: string }) => t.path)).toEqual(["/anime/a", "/anime/b"]);
+    expect(store.has(LOCK)).toBe(false); // lock released
+  });
+
+  it("does not rebuild a fresh inventory", async () => {
+    store.set(KEY, JSON.stringify(stored));
+    store.set(FRESH, "1");
+    const { loadSitemapInventory } = await load();
+    await loadSitemapInventory();
+    expect(walkCalls).toBe(0);
+  });
+
+  it("leaves the rebuild to the worker holding the lock", async () => {
+    store.set(KEY, JSON.stringify(stored));
+    store.set(LOCK, "other-process");
+    const { loadSitemapInventory } = await load();
+    const r = await loadSitemapInventory();
+    expect(r.titles.map((t) => t.path)).toEqual(["/anime/old"]);
+    await new Promise((resolve) => setTimeout(resolve, 0));
+    expect(walkCalls).toBe(0);
+  });
+
+  it("builds once on a cold start and shares the build between concurrent requests", async () => {
+    const { loadSitemapInventory } = await load();
+    const [a, b] = await Promise.all([loadSitemapInventory(), loadSitemapInventory()]);
+    expect(walkCalls).toBe(1);
+    expect(a.titles).toHaveLength(2);
+    expect(b.titles).toHaveLength(2);
+    expect(store.has(KEY)).toBe(true);
+  });
+
+  it("does not overwrite a good inventory with an empty walk", async () => {
+    store.set(KEY, JSON.stringify(stored));
+    const cq = await import("@/modules/catalog/catalog-query");
+    vi.mocked(cq.walkAnimeCatalogList).mockResolvedValueOnce([]);
+    const { loadSitemapInventory } = await load();
+    await loadSitemapInventory();
+    await vi.waitFor(() => expect(store.has(LOCK)).toBe(false));
+    expect(JSON.parse(store.get(KEY)!).titles.map((t: { path: string }) => t.path)).toEqual(["/anime/old"]);
+  });
+});
