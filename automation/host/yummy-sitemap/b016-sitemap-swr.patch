+// B016 (2026-10-14): the inventory used to live in Redis for exactly one hour,
+// and the first request after expiry rebuilt it synchronously — 80 sequential
+// list pages plus 40 detail calls, 35–57 s. Behind a 30 s proxy timeout
+// (yummyani7.site/.info) that request answered 504, and a crawler that fetches
+// sitemaps rarely almost always arrived after expiry. Parallel requests for
+// titles/seasons/episodes each started their own rebuild.
+//
+// Now: the last good inventory is kept (DATA_TTL_SEC) and served immediately;
+// freshness is a separate marker (FRESH_TTL_SEC). A stale inventory is
+// refreshed in the background by exactly one worker (Redis lock + in-process
+// single flight). Only a cold start with no stored inventory waits for the
+// build, and concurrent requests share that one build.
 const CACHE_KEY = "seo:sitemap-inventory:v4-anime";
-const CACHE_TTL_SEC = 3600;
+const FRESH_KEY = "seo:sitemap-inventory:v4-anime:fresh";
+const LOCK_KEY = "seo:sitemap-inventory:v4-anime:lock";
+const FRESH_TTL_SEC = 3600;
+const DATA_TTL_SEC = 7 * 24 * 3600;
+const LOCK_TTL_SEC = 300;
 const DETAIL_LIMIT = 40;
 
+let inflight: Promise<SitemapInventory | null> | null = null;
+
+type RedisLike = Awaited<ReturnType<typeof getRedis>>;
+
+async function redisOrNull(): Promise<RedisLike | null> {
+  try {
+    return await getRedis();
+  } catch {
+    return null; // Cache is optional.
+  }
+}
+
+async function buildInventory(): Promise<SitemapInventory> {
+  const titles = await walkAnimeCatalogList();
+  const details = [];
+  for (const title of titles.slice(0, DETAIL_LIMIT)) {
+    const detail = await getCatalogTitle(title.slug);
+    details.push(detail ?? title);
+  }
+  const rest = titles.slice(DETAIL_LIMIT);
+  return inventoryFromTitles([...details, ...rest], new Date(SEO_CONTENT_UPDATED_AT));
+}
+
+function isEmpty(inventory: SitemapInventory): boolean {
+  return (inventory.titles ?? []).length === 0;
+}
+
+/** One rebuild per process at a time; across processes — the Redis lock. */
+function refresh(redis: RedisLike | null, needLock: boolean): Promise<SitemapInventory | null> {
+  if (inflight) {
+    return inflight;
+  }
+  inflight = (async () => {
+    if (redis && needLock) {
+      const got = await redis.set(LOCK_KEY, String(Date.now()), { NX: true, EX: LOCK_TTL_SEC }).catch(() => null);
+      if (!got) {
+        return null; // Another worker is rebuilding; keep serving what we have.
+      }
+    }
+    try {
+      const inventory = await buildInventory();
+      // An empty walk (provider outage) must not replace a good inventory.
+      if (redis && !isEmpty(inventory)) {
+        await redis.set(CACHE_KEY, JSON.stringify(inventory), { EX: DATA_TTL_SEC }).catch(() => null);
+        await redis.set(FRESH_KEY, "1", { EX: FRESH_TTL_SEC }).catch(() => null);
+      }
+      return inventory;
+    } finally {
+      if (redis && needLock) {
+        await redis.del(LOCK_KEY).catch(() => null);
+      }
+    }
+  })().finally(() => {
+    inflight = null;
+  });
+  return inflight;
+}
