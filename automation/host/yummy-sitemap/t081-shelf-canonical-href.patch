+import { PUBLIC_TITLE_SEPARATOR } from "@/modules/catalog/public-title-route";
+
+/**
+ * T081 (2026-10-14): watcher shelves on the home page know a title only by its
+ * provider id, so their links use the composite segment `{human}--{id}`, which
+ * the router answers with 308 to the canonical `/anime/{slug}`. On yummyani.site
+ * and .biz 55 of 102 title links on the home page went through that redirect.
+ *
+ * Here a composite segment is replaced with the canonical slug ONLY when the
+ * registry already has one for that provider id. The lookup is read-only: no
+ * slug is allocated or changed from a shelf (that stays with the title page).
+ * No canonical slug yet — the composite link stays and the router still works.
+ */
+export type CanonicalSlugLookup = (providerTitleId: string) => Promise<string | null>;
+
+type CardWithHref = { titleId: string; href: string };
+
+export function replaceCompositeSegment(href: string, providerTitleId: string, slug: string): string {
+  const marker = `${PUBLIC_TITLE_SEPARATOR}${providerTitleId}`;
+  const segments = href.split("/");
+  const index = segments.findIndex((segment) => segment.endsWith(marker));
+  if (index < 0) {
+    return href;
+  }
+  segments[index] = slug;
+  return segments.join("/");
+}
+
+export async function canonicalizeShelfHrefs<T extends CardWithHref>(
+  cards: readonly T[],
+  lookup: CanonicalSlugLookup,
+): Promise<T[]> {
+  const ids = [
+    ...new Set(
+      cards
+        .filter((card) => card.titleId && card.href.includes(`${PUBLIC_TITLE_SEPARATOR}${card.titleId}`))
+        .map((card) => card.titleId),
+    ),
+  ];
+  const slugs = new Map<string, string>();
+  const chunkSize = 25;
+  for (let index = 0; index < ids.length; index += chunkSize) {
+    const chunk = ids.slice(index, index + chunkSize);
+    const found = await Promise.all(chunk.map((id) => lookup(id).catch(() => null)));
+    chunk.forEach((id, position) => {
+      const slug = found[position]?.trim();
+      if (slug && !slug.includes(PUBLIC_TITLE_SEPARATOR)) {
+        slugs.set(id, slug);
+      }
+    });
+  }
+  if (slugs.size === 0) {
+    return [...cards];
+  }
+  return cards.map((card) => {
+    const slug = slugs.get(card.titleId);
+    return slug ? { ...card, href: replaceCompositeSegment(card.href, card.titleId, slug) } : card;
+  });
+}
