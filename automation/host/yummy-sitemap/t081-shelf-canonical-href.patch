+/**
+ * Canonical public slug already registered for a provider id — read only (T081).
+ * Never allocates or changes a slug; `null` when the title has none yet.
+ */
+export async function canonicalPublicSlugOf(providerTitleId: string): Promise<string | null> {
+  const id = providerTitleId.trim();
+  if (!id || !isProviderTitleId(id)) {
+    return null;
+  }
+  const rows = await store().listByProvider(id);
+  return rows.find((row) => row.canonical)?.slug ?? null;
+}
