diff --git a/tests/unit/shelf-canonical-href.test.ts b/tests/unit/shelf-canonical-href.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/unit/shelf-canonical-href.test.ts
@@ -0,0 +1,49 @@
+import { describe, expect, it, vi } from "vitest";
+
+import { canonicalizeShelfHrefs, replaceCompositeSegment } from "@/modules/catalog/shelf-canonical-href";
+
+// T081: home-page watcher shelves linked to `/anime/{human}--{uuid}`, answered 308.
+const ID = "01a067b1-030f-7f4b-b995-38cb0c2bb71a";
+const OTHER = "019fb2ac-e04b-78df-bdf4-e50fafdae2ff";
+
+describe("shelf links go straight to the canonical title address (T081)", () => {
+  it("replaces only the composite segment of the same provider id", () => {
+    expect(replaceCompositeSegment(`/anime/stranniki-duhovnogo-mira--${ID}`, ID, "stranniki-duhovnogo-mira")).toBe(
+      "/anime/stranniki-duhovnogo-mira",
+    );
+    expect(replaceCompositeSegment(`/anime/x--${ID}/season/2/episode/5`, ID, "x")).toBe("/anime/x/season/2/episode/5");
+    expect(replaceCompositeSegment(`/anime/x--${OTHER}`, ID, "x")).toBe(`/anime/x--${OTHER}`);
+  });
+
+  it("uses the registered slug and keeps the composite link when none is registered", async () => {
+    const lookup = vi.fn(async (id: string) => (id === ID ? "stranniki-duhovnogo-mira" : null));
+    const cards = [
+      { titleId: ID, href: `/anime/stranniki-duhovnogo-mira--${ID}`, name: "a" },
+      { titleId: OTHER, href: `/anime/syunmao-li--${OTHER}`, name: "b" },
+      { titleId: "plain", href: "/anime/already-canonical", name: "c" },
+    ];
+    const out = await canonicalizeShelfHrefs(cards, lookup);
+    expect(out.map((c) => c.href)).toEqual([
+      "/anime/stranniki-duhovnogo-mira",
+      `/anime/syunmao-li--${OTHER}`,
+      "/anime/already-canonical",
+    ]);
+    // Canonical links are not looked up; each provider id at most once.
+    expect(lookup).toHaveBeenCalledTimes(2);
+    expect(out[0]?.name).toBe("a");
+  });
+
+  it("never fails the shelf when the registry is unavailable", async () => {
+    const cards = [{ titleId: ID, href: `/anime/x--${ID}` }];
+    const out = await canonicalizeShelfHrefs(cards, async () => {
+      throw new Error("db down");
+    });
+    expect(out).toEqual(cards);
+  });
+
+  it("ignores a lookup answer that is itself composite", async () => {
+    const cards = [{ titleId: ID, href: `/anime/x--${ID}` }];
+    const out = await canonicalizeShelfHrefs(cards, async () => `x--${ID}`);
+    expect(out[0]?.href).toBe(`/anime/x--${ID}`);
+  });
+});
