# Короткая проверка сети каждые 6 часов: доступность, индексация, свежесть данных, результат публикаций.
# 08:25, 14:25, 20:25, 02:25 МСК. 05:25 UTC — после сбора аналитики
# (analytics-cabinet, 05:00 UTC) и до суточного отчёта (05:40 UTC), чтобы
# суточный прогон взял эту проверку, а не повторял её.
#
# Persistent=true: пропущенный из-за простоя запуск выполняется после старта,
# а слот (одна проверка на 6 часов, один отчёт в сутки) не даёт ему
# выполниться дважды.
[Unit]
Description=SEO regular: check

[Timer]
OnCalendar=*-*-* 05,11,17,23:25:00 UTC
Persistent=true
RandomizedDelaySec=60
AccuracySec=30s
Unit=seo-regular-check.service

[Install]
WantedBy=timers.target
