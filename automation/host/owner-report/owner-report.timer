[Unit]
# Три точки расписания задания владельца, в Europe/Moscow.
#
# `OnCalendar` с явной зоной: писать время в UTC нельзя — при переходе зоны
# отчёт уехал бы на час, и «10:00» в заголовке перестало бы совпадать с
# действительностью.
#
# Минуты 02 вместо 00 намеренно: ровно в 00 минут на машине срабатывают
# соседние таймеры (`seo-regular-*`, доставка каталога), и отчёт, собранный
# ОДНОВРЕМЕННО с ними, прочитал бы состояние на середине их работы.
Description=Расписание отчётов владельцу (10:00/18:00/22:00 Europe/Moscow)

[Timer]
OnCalendar=*-*-* 10:02:00 Europe/Moscow
OnCalendar=*-*-* 18:02:00 Europe/Moscow
OnCalendar=*-*-* 22:02:00 Europe/Moscow
# Пропущенное срабатывание (выключенная машина, занятый менеджер) выполняется
# при следующей возможности: период отчёта считается от ПРЕДЫДУЩЕГО отчёта,
# поэтому ничего не теряется и не дублируется.
Persistent=true
AccuracySec=1min
Unit=owner-report.service

[Install]
WantedBy=timers.target
