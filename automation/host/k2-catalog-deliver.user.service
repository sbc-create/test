[Unit]
# Пользовательский вариант суточной доставки каталога на узел K2.
#
# Зачем он рядом с системным. Системный юнит ставится в
# /etc/systemd/system — это root на управляющем узле, и из-за одного таймера
# ждать владельца незачем: доставка работает ОТ ИМЕНИ claude и пишет только в
# домашний каталог k2deploy на другой машине (установку с правами витрины
# делает корневой приёмщик НА УЗЛЕ). Для claude включён linger
# (/var/lib/systemd/linger/claude), то есть пользовательские юниты живут и
# после выхода из сессии — этим же способом здесь уже работает
# seo-daily-cycle.timer.
#
# Что НЕ меняется: сама доставка, её расписание и пределы. Разница только в
# том, кто держит таймер — системный менеджер или пользовательский.
Description=K2: суточная доставка каталога восьми витрин (пользовательский юнит)
After=network-online.target

[Service]
Type=oneshot
# `User=`/`Group=` здесь не указываются: пользовательский менеджер и так
# работает от claude, а с ними юнит не запустится вовсе.
# Постоянный каталог доставки, а не рабочая копия сессии: та временная.
# Копия /srv/site-factory/repo для этого не годится — измерено
# 2026-10-17, она принадлежит другой линии и стоит на её ветке
# (claude/players-only-production-009), переключать её нельзя.
# Набор раскладывает и сверяет automation/local/k2-install-delivery.py
# (--provision / --verify): в каталоге лежит опись INSTALL.json с
# коммитом источника и суммами файлов.
WorkingDirectory=/srv/site-factory/k2-delivery
ExecStart=/bin/bash automation/local/k2-deliver-catalog.sh lords-10 lords-11 lords-12 lords-13 lords-14 lords-15 lords-16 lords-17
# Издатель держит в памяти снимок поставщика целиком: измерено 1,197 ГиБ пика
# на восьми витринах. Предел выше измеренного, но ниже того, при котором на
# разделе не останется места работающим витринам.
MemoryMax=3G
# Полный прогон доставки восьми 15.10 занял 9 минут (издатель ~6 мин, доставка
# ~3 мин). Потолок с запасом на медленный диск.
TimeoutStartSec=2700
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=default.target
