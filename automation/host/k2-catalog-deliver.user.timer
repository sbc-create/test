[Unit]
# Раз в сутки, в стороне от суточного прогона производителя (03:3x UTC): к
# этому времени свежий снимок поставщика уже собран, и доставка несёт его, а
# не вчерашний. Приёмщик на узле подхватывает комплект своим таймером (каждые
# 15 минут), поэтому согласовывать минуты между машинами не требуется.
Description=K2: суточная доставка каталога восьми витрин (пользовательский таймер)

[Timer]
OnCalendar=*-*-* 05:20:00 UTC
# Пропущенный из-за выключения прогон выполняется при следующем старте: иначе
# сутки простоя означали бы сутки старого каталога на витринах.
Persistent=true
RandomizedDelaySec=300
Unit=k2-catalog-deliver.user.service

[Install]
WantedBy=timers.target
