[Unit]
Description=lords: canary одной витрины %i на живом каталоге и закреплённом артефакте
Documentation=file:///srv/site-factory/coordination/v1/handoffs/012-core-to-owner-canary-mode-and-regression.md
After=network-online.target
Wants=network-online.target
# Одновременный запуск с обновлением содержимого означал бы двух писателей в
# один каталог релизов. Сценарий сам останавливает таймер, но конфликт с уже
# идущим циклом надо исключить до старта, а не разбирать по следам.
Conflicts=lords-content-refresh.service

[Service]
Type=oneshot
# Разрешение живёт ровно столько, сколько идёт операция: oneshot завершается,
# и никакой постоянной службы с правами на выкладку не остаётся.
RemainAfterExit=no

# Дерево с закреплённым артефактом, а не боевой checkout: выкатывается ровно то,
# что названо в TEMPLATE_TO_CORE-008, и сценарий сверяет отпечаток сам.
WorkingDirectory=/home/claude/wt-canary
Environment=LORDS_SNAPSHOT_DIR=/srv/site-factory/repo/var/lords/lords/catalog-cache
Environment=FACTORY_PYTHON=/home/claude/work-templates/site-factory/.venv/bin/python3

# Та же привязка учётных данных, что у штатного обновления содержимого.
# Значения не попадают ни в окружение, ни в вывод: сценарий читает файл из
# $CREDENTIALS_DIRECTORY и печатает только число собранных записей.
LoadCredential=cdnvideohub_api_token:/etc/site-factory/secrets/lords/lords-01/cdnvideohub-api-token
LoadCredential=cdnvideohub_publisher_id:/etc/site-factory/secrets/lords/lords-01/cdnvideohub-publisher-id
Environment=CDNVIDEOHUB_API_TOKEN_CREDENTIAL=cdnvideohub_api_token
Environment=CDNVIDEOHUB_PUBLISHER_ID_CREDENTIAL=cdnvideohub_publisher_id

ExecStart=/home/claude/wt-canary/automation/host/lords-canary-apply.sh %i

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# ProtectHome здесь НЕТ намеренно, и это не послабление.
#
# `ProtectSystem=strict` уже монтирует всю иерархию только для чтения, включая
# /home; писать можно ровно в ReadWritePaths и никуда больше. А `ProtectHome`
# перемонтирует /home отдельно, и заявленные ниже пути под ним оказываются в
# конфликте: служба падает на построении пространства имён — до ExecStart, без
# единой строки в собственном журнале и без следов на диске.
#
# Именно так первый запуск и завершился «ничем»: ни релиза, ни журнала
# операции, ни файлов от root. У работающей рядом службы обновления содержимого
# путей под /home в ReadWritePaths нет вовсе, поэтому её ProtectHome не мешает.
InaccessiblePaths=/etc/site-factory/secrets
# Писать можно ровно туда, куда нужно операции: рантайм витрин, кэш и отчёты
# репозитория с артефактом, журнал. Ни nginx, ни /etc, ни соседние службы.
ReadWritePaths=/srv/lords /home/claude/wt-canary/var /home/claude/wt-canary/artifacts /var/log/site-factory
ReadOnlyPaths=/srv/site-factory/repo /etc/site-factory
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0022

# Полная сборка 53 тысяч страниц занимает часы; canary делается один раз и
# ждать его разумно. Потолок вдвое выше замеренного полного рендера.
TimeoutStartSec=18000
MemoryMax=3G
TasksMax=256
