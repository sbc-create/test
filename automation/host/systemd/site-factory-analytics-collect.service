[Unit]
Description=site-factory: daily read-only pull of Yandex Metrika and Webmaster metrics
Documentation=file:///srv/site-factory/repo/docs/YANDEX_ANALYTICS.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=claude
Group=claude
WorkingDirectory=/srv/site-factory/repo
EnvironmentFile=/etc/site-factory/environment

LoadCredential=yandex_oauth:/etc/site-factory/secrets/yandex_oauth_token
Environment=YANDEX_OAUTH_TOKEN_FILE=%d/yandex_oauth

# Только чтение: ни --confirm-writes, ни webmaster --verify здесь нет и быть не
# может. Отчёт складывается в artifacts/ и не меняет ни одного счётчика.
ExecStart=/srv/site-factory/repo/bin/seo-operator analytics-collect --json

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/site-factory/repo/var /srv/site-factory/repo/artifacts /var/log/site-factory
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=512M
TasksMax=64
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
