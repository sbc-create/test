[Unit]
# Регулярность — четверть часа: доставка приходит с управляющего узла по мере
# готовности снимка, и ждать суток незачем. Пустой входящий каталог стоит
# мгновенного прогона, поэтому частота дёшева.
Description=K2: регулярная установка доставленного каталога

[Timer]
OnBootSec=3min
OnUnitActiveSec=15min
# Пропущенный из-за выключения прогон выполняется при следующем старте: иначе
# после перезагрузки витрина молча оставалась бы на старом снимке.
Persistent=true
AccuracySec=30s
Unit=k2-catalog-apply.service

[Install]
WantedBy=timers.target
