# Полный SEO-отчёт владельцу в 09:00 МСК (06:00 UTC). Суточный анализ стартует
# в 05:40 UTC с бюджетом 14 минут, отчёт к этому времени готов; если его нет —
# приходит сообщение об этом, а не тишина.
[Unit]
Description=SEO-отчёт в Telegram в 09:00 МСК

[Timer]
OnCalendar=*-*-* 06:00:00 UTC
Persistent=true
AccuracySec=30s
Unit=notify@daily.service

[Install]
WantedBy=timers.target
