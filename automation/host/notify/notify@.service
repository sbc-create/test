# Доставка SEO-отчётов в Telegram: notify@test | notify@daily | notify@alerts.
#
# Токен и подтверждённый чат приходят через LoadCredential из
# /etc/site-factory/secrets/telegram (root, 0700/0600); сессии агента они не
# выдаются, в журналы не пишутся. Пока владелец не подтвердил чат (нет файла
# chat_id), юнит не запускается вовсе — условие ниже. Поиск чата —
# notify-discover.service, ему чат не нужен. Подробно — docs/REPORT_DELIVERY.md.
[Unit]
Description=Доставка SEO-отчётов в Telegram: %i
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/site-factory/secrets/telegram/bot_token
ConditionPathExists=/etc/site-factory/secrets/telegram/chat_id

[Service]
Type=oneshot
User=claude
Group=claude
WorkingDirectory=/home/claude/wt-portable-site-cell-01
Environment=PYTHONDONTWRITEBYTECODE=1
LoadCredential=telegram_bot_token:/etc/site-factory/secrets/telegram/bot_token
LoadCredential=telegram_chat_id:/etc/site-factory/secrets/telegram/chat_id
ExecStart=/usr/bin/python3 -m seo_operator.cli notify %i
TimeoutStartSec=120
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/claude/wt-portable-site-cell-01/var/notify
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
