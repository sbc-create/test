# Поиск чата владельца: кто написал боту /start. Ничего не отправляет.
# Итог (id, тип, имя чата — не секреты) — var/notify/chat-candidates.json.
[Unit]
Description=Доставка SEO-отчётов в Telegram: поиск чата владельца
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/site-factory/secrets/telegram/bot_token

[Service]
Type=oneshot
User=claude
Group=claude
WorkingDirectory=/home/claude/wt-portable-site-cell-01
Environment=PYTHONDONTWRITEBYTECODE=1
LoadCredential=telegram_bot_token:/etc/site-factory/secrets/telegram/bot_token
ExecStart=/usr/bin/python3 -m seo_operator.cli notify discover
TimeoutStartSec=60
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/claude/wt-portable-site-cell-01/var/notify
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
