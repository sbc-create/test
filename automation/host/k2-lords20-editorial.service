[Unit]
Description=Exact lords20 native editorial queue transport
After=network-online.target
[Service]
Type=oneshot
User=claude
Group=claude
WorkingDirectory=/home/claude/wt-portable-site-cell-01
Environment=PYTHONPATH=/home/claude/wt-portable-site-cell-01
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m factory.cell.k2_lords20_editorial
TimeoutStartSec=240
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/site-cells-k2-lords20 /home/claude/.ssh
