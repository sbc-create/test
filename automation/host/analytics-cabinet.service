# Чтение статистики из кабинета Метрики. Только чтение, ничего не меняет.
#
# Зачем отдельный юнит, когда есть site-factory-analytics-collect.
# Тот читает реестр из /srv/site-factory/repo, где на 27.09 объявлено ШЕСТЬ
# доменов, и он не включён (в timers.target.wants его нет, artifacts/analytics
# не существует — то есть сбор не выполнялся ни разу). Реестр этой ветки
# описывает шестнадцать доменов, включая zonafilm.space с подтверждённым
# счётчиком. Прогон по старому реестру дал бы неполную картину и выглядел бы
# полным.
#
# Токен читает служба, а не сессия агента: значение приходит через
# LoadCredential в /run/credentials/%n и живёт только на время прогона. Каталог
# /etc/site-factory/secrets закрыт для учётной записи claude, и это правильно —
# отчёт ей нужен, секрет нет.
[Unit]
Description=Статистика Метрики по всем доменам реестра (только чтение)
After=network-online.target
ConditionPathExists=/home/claude/wt-portable-site-cell-01/config/analytics.json

[Service]
Type=oneshot
User=claude
Group=claude
WorkingDirectory=/home/claude/wt-portable-site-cell-01
LoadCredential=yandex_oauth:/etc/site-factory/secrets/yandex_oauth_token
# Путь к секрету вычисляет КОД по $CREDENTIALS_DIRECTORY: специфера %d в
# systemd 249 (Ubuntu 22.04) нет, он появился в 250, и строка оставалась
# literal-ом — служба падала на «файл не найден», не назвав причины.
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/usr/bin/install -d -m 0755 /home/claude/wt-portable-site-cell-01/var/analytics
ExecStart=/home/claude/wt-portable-site-cell-01/bin/seo-operator analytics-collect \
    --json --out /home/claude/wt-portable-site-cell-01/var/analytics/cabinet-latest.json

# Причина отказа обязана быть видна без journalctl: у сессии агента доступа к
# журналу нет, и пустой каталог отчётов неотличим от «служба не запускалась».
StandardOutput=journal
# Файл лежит в var/, а не в var/analytics/: поток systemd открывает ДО
# ExecStartPre, и путь в ещё не созданном каталоге уронил бы юнит на самой
# подготовке — с причиной, которую этот же файл и должен был показать.
StandardError=append:/home/claude/wt-portable-site-cell-01/var/analytics-cabinet-stderr.log

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# Сборщик пишет ДВА пути: файл из --out и артефакт прогона. Без второго пути
# ProtectSystem=strict отказывает в записи, и прогон не оставляет ни отчёта,
# ни причины: ровно так прошёл впустую запуск 18:42.
ReadWritePaths=/home/claude/wt-portable-site-cell-01/var /home/claude/wt-portable-site-cell-01/artifacts
ProtectKernelTunables=true
RestrictSUIDSGID=true
