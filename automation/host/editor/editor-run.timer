# Фоновый редактор: проверка каждые 5 минут, модель — не чаще раза в час и только
# при наличии работы (решает seo_operator.editor_run.gate: свободное задание
# Animedia или кандидат без результата + 55 минут с прошлого запуска модели).
# Пересечения исключает flock в editor-run.sh, длительность — timeout 25 мин.
[Unit]
Description=Фоновый редактор сети: лёгкая проверка каждые 5 минут

[Timer]
OnCalendar=*:0/5
Persistent=false
AccuracySec=10s
Unit=editor-run.service

[Install]
WantedBy=timers.target
