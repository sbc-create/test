# Через минуту после завершения прошлого прогона — следующая задача (B006, 14.10).
# Пустая очередь проверяется без модели (seo-tech-next --peek), поэтому частый запуск дешёв.
# OnCalendar — страховка на случай, если служба ушла в failed и OnUnitInactiveSec не сработал.
[Unit]
Description=Техническое SEO сети: следующая задача через минуту после предыдущей (seo-tech-run)

[Timer]
OnActiveSec=1min
OnUnitInactiveSec=1min
OnCalendar=*:0/15
AccuracySec=10s
Unit=seo-tech-run.service

[Install]
WantedBy=timers.target
