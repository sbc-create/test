# Техническое SEO: прогон раз в полчаса. Задач в очереди 26, каждая занимает до
# 25 минут, значит полчаса — это шаг, при котором очередь проходится за ночь, а
# затянувшийся прогон просто получает 75 на следующем ходу и ничего не ломает.
#
# Минуты :12 и :42 выбраны вне пятиминутной сетки таймера редактора, чтобы два
# прогона Claude Code не стартовали в одну минуту и не делили процессор.
[Unit]
Description=Техническое SEO сети: прогон раз в полчаса

[Timer]
OnCalendar=*:12/30
# Пропущенный ход не догоняется: следующий всё равно возьмёт следующую свободную
# задачу, а накопленные запуски пришли бы пачкой и столкнулись бы на flock.
Persistent=false
AccuracySec=10s
Unit=seo-tech-run.service

[Install]
WantedBy=timers.target
