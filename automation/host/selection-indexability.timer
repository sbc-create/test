[Unit]
Description=Расписание проверки индексируемости выборок каталога

[Timer]
# Через полчаса после сверки карт (05:15 UTC): тот же повод — снимки каталога
# пересобираются ночью (измерено: catalog_built_at 03:16Z), а раньше них
# проверять нечего. Разнесено с ней намеренно, чтобы два прохода не опрашивали
# одни витрины одновременно.
OnCalendar=*-*-* 05:45:00 UTC
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
