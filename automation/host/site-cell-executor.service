# Исполнитель заявок на выпуск выделенных сайтов.
#
# Запускается по таймеру, разбирает накопившиеся заявки и завершается. Демон с
# бесконечным циклом здесь не нужен и вреден: операция длится минуты, и упавший
# посреди неё демон не оставил бы следа. Разбор по таймеру плюс журнал переходов
# на диске дают восстановление после гибели процесса и после перезагрузки.
[Unit]
Description=site-factory: разбор заявок на выпуск выделенных сайтов
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Активация витрины длится минуты: она читает снимки каталога. Предел времени
# здесь означал бы убийство выкладки на середине.
TimeoutStartSec=0
WorkingDirectory=/usr/local/lib/site-factory-cell
Environment=PYTHONPATH=/usr/local/lib/site-factory-cell
Environment=SITE_CELL_QUEUE=/var/lib/site-cells
Environment=PYTHONDONTWRITEBYTECODE=1
# РЕЕСТР ЯЧЕЕК — авторитетный файл фабрики, а не копия внутри пакета.
#
# Измерено 2026-10-04: разрешение владельца легло в авторитетный реестр в
# 08:32:42, а исполнитель читал копию, снятую установкой в 07:10:34, и отказал
# словами «open_authorized не равно true». Один путь внутри пакета указывал на
# два разных файла, и устаревший снимок выглядел отсутствием разрешения.
#
# Установщик делает ещё и ссылку на тот же файл; переменная здесь — второй
# рубеж: она действует, даже если копия пакета окажется старой. Доверять
# файлу, доступному на запись учётной записи инструментов, можно потому, что
# разрешение владельца требует ВТОРОГО факта — подтверждения в каталоге root,
# которого инструмент создать не может.
Environment=SITE_CELLS_REGISTRY=/home/claude/wt-portable-site-cell-01/config/site-cells.json
ExecStart=/usr/bin/python3 -m factory cell serve --confirm-activation

# Исполнитель обязан быть root: он ставит службы и переключает маршрут. Всё
# остальное урезано — он не должен уметь ничего сверх своей задачи.
NoNewPrivileges=no
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
