# Исполнитель заявок на выпуск выделенных сайтов.
#
# Запускается по таймеру, разбирает накопившиеся заявки и завершается. Демон с
# бесконечным циклом здесь не нужен и вреден: операция длится минуты, и упавший
# посреди неё демон не оставил бы следа. Разбор по таймеру плюс журнал переходов
# на диске дают восстановление после гибели процесса и после перезагрузки.
[Unit]
Description=site-factory: разбор заявок на выпуск выделенных сайтов
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Активация витрины длится минуты: она читает снимки каталога. Предел времени
# здесь означал бы убийство выкладки на середине.
TimeoutStartSec=0
WorkingDirectory=/usr/local/lib/site-factory-cell
Environment=PYTHONPATH=/usr/local/lib/site-factory-cell
Environment=SITE_CELL_QUEUE=/var/lib/site-cells
Environment=PYTHONDONTWRITEBYTECODE=1
# РЕЕСТР ЯЧЕЕК не берётся из рабочего каталога сессии. Ссылка туда
# означала бы, что право записи в рабочий каталог равно праву решать,
# какой юнит и из какого каталога поставит root: реестр задаёт учётную
# запись, порт, юнит и пути. Исполнитель читает КОРНЕВУЮ копию, а
# разрешение владельца доставляет в неё команда владельца
# authorize-indexing.sh — она уже root и переносит только поля
# разрешения названного домена (решение D147).
ExecStart=/usr/bin/python3 -m factory cell serve --confirm-activation

# Исполнитель обязан быть root: он ставит службы и переключает маршрут. Всё
# остальное урезано — он не должен уметь ничего сверх своей задачи.
NoNewPrivileges=no
ProtectHome=read-only

# ЗАПИСЬ РАЗРЕШЕНА РОВНО ДВУМ КАТАЛОГАМ, и оба нужны по делу.
#
# Измерено 2026-10-04: заявка `lords-01-consent-grant-20261004-184926` была
# отвергнута словами `cp: cannot create regular file
# '…/config/site-cells.json.bak.20261004T185001Z': Read-only file system`.
# Дело не в правах: каталог `drwxrwxr-x claude claude`, и root записал бы в
# него свободно. Дело в МОНТИРОВАНИИ — `ProtectHome=read-only` выше делает
# /home доступным только на чтение для этой службы.
#
# Разрешаются КАТАЛОГИ, а не файлы: команда владельца пишет реестр атомарно —
# временный файл рядом и переименование, — плюс копию прежнего состояния
# `.bak.<метка>`. Разрешения на один файл для этого недостаточно.
#
# Общая защита службы не снимается: `ProtectHome=read-only` остаётся, и всё
# остальное в /home для неё по-прежнему только для чтения.
ReadWritePaths=/home/claude/wt-portable-site-cell-01/config
ReadWritePaths=/usr/local/lib/site-factory-cell/config
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
