# Раз в сутки после суточного обновления контента. Persistent — пропущенный
# запуск догоняется, иначе после простоя хоста отчёт молча устарел бы.
[Unit]
Description=Статистика Метрики по всем доменам реестра

#
# 05:00 UTC (08:00 МСК), а не 06:10. Прежнее время шло ПОСЛЕ отчёта владельцу в
# 09:00 МСК (06:00 UTC): измерено 2026-10-08 — отчёт 06:00:26Z, снимок 06:19:44Z,
# то есть утренний отчёт каждый день видел вчерашний снимок. Сбор занимает до
# 10 минут; к проверке в 05:25 UTC и суточному анализу в 05:40 UTC снимок
# готов. Данные «до вчера» Метрика к этому часу уже отдаёт.
[Timer]
OnCalendar=*-*-* 05:00:00 UTC
Persistent=true
RandomizedDelaySec=300
Unit=analytics-cabinet.service

[Install]
WantedBy=timers.target
