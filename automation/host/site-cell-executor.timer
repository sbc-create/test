# Опрос очереди заявок раз в минуту.
#
# Почему OnCalendar, а не OnBootSec/OnUnitActiveSec
# -------------------------------------------------
#
# Прежняя связка `OnBootSec=2min` + `OnUnitActiveSec=1min` на живой машине дала
# `NEXT: n/a`: момент загрузки давно прошёл, а `OnUnitActiveSec` отсчитывается
# от последней активации СЛУЖБЫ, которой ещё не было. Ни один источник времени
# не дал следующей точки, таймер не запланировал ничего, и поданная заявка
# пролежала в очереди необработанной. Снаружи это выглядит как работающий
# включённый таймер — `enabled`, `active`, и ни одного запуска.
#
# `OnCalendar` считает от стенных часов и планирует следующую минуту всегда,
# независимо от того, запускалась служба раньше или нет.
#
# `Persistent=true` работает именно с OnCalendar: пропущенный из-за перезагрузки
# разбор состоится сразу после старта, иначе выпуск повис бы до следующей
# минуты — а в худшем случае до следующей загрузки.
#
# `AccuracySec=5s` — иначе systemd вправе сдвинуть срабатывание на минуту ради
# экономии пробуждений, и «раз в минуту» превратилось бы в «когда-нибудь».
[Unit]
Description=site-factory: опрос очереди заявок на выпуск

[Timer]
OnCalendar=*:0/1
AccuracySec=5s
Persistent=true
Unit=site-cell-executor.service

[Install]
WantedBy=timers.target
