+    def _сезон_серии(self, slug: str, эпизод: int, доступно: int) -> tuple[int, int]:
+        """Сезон и номер ДОСТУПНОЙ серии: по данным подробностей, не по догадке.
+
+        Расписание называет номер серии внутри сезона, а ссылка требует и
+        номер сезона. Зашитая единица ломала каждый тайтл-продолжение.
+
+        Правило: ищем сезон, в доступных номерах которого есть эта серия, и
+        при нескольких берём ПОСЛЕДНИЙ такой — продолжения выходят в старшем
+        сезоне. Не нашли ни одного — возвращаем (0, 0), и вызывающий ставит
+        ссылку на страницу тайтла: лучше карточка, чем 404.
+        """
+        деталь = self.деталь(slug) or {}
+        подходящие = []
+        for к in (деталь.get("seasons") or []):
+            if not isinstance(к, dict):
+                continue
+            номера = доступные_номера(к)
+            if эпизод and эпизод in номера:
+                подходящие.append((int(к.get("number") or 0), эпизод))
+        if подходящие:
+            return max(подходящие, key=lambda п: п[0])
+        # Серии с таким номером нет ни в одном сезоне: отдаём последнюю
+        # доступную последнего сезона, у которого вообще есть доступные.
+        с_доступными = [(int(к.get("number") or 0), max(доступные_номера(к)))
+                        for к in (деталь.get("seasons") or [])
+                        if isinstance(к, dict) and доступные_номера(к)]
+        if с_доступными:
+            return max(с_доступными, key=lambda п: п[0])
+        return (0, 0)
+
