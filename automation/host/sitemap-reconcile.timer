[Unit]
Description=Расписание сверки полноты и свежести карт сети

[Timer]
# Через час с лишним после обновления контентного контура (04:00 UTC,
# yummy-content-refresh.timer) и после ночной пересборки снимков каталога
# (измерено 20.10: catalog_built_at 03:16Z). Раньше них сверять нечего: карта
# ещё отражает прошлые сутки.
OnCalendar=*-*-* 05:15:00 UTC
Persistent=true
# Проход опрашивает 17 витрин и скачивает их карты целиком. Разброс нужен,
# чтобы запуск не совпадал с минутой в минуту с другими таймерами узла.
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
