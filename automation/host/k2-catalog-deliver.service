[Unit]
# Регулярная доставка каталога на узел K2 — со стороны УПРАВЛЯЮЩЕГО узла.
#
# Половина цепочки живёт здесь: снимок поставщика и издатель — на управляющем
# узле, приём и установка — на K2. Без этого юнита обновление оставалось бы
# ручным: витрины стояли бы на снимке дня переноса, а узнать об этом было бы
# неоткуда — сайты отвечают 200 и со старым каталогом.
#
# Запускается от учётной записи claude: root здесь не нужен, потому что
# доставка пишет только в домашний каталог k2deploy на другой машине, а
# установку с правами витрины делает корневой приёмщик НА УЗЛЕ.
Description=K2: доставка свежего каталога восьми витрин
After=network-online.target

[Service]
Type=oneshot
User=claude
Group=claude
WorkingDirectory=/home/claude/wt-nova-publish-memory-02
ExecStart=/bin/bash automation/local/k2-deliver-catalog.sh lords-10 lords-11 lords-12 lords-13 lords-14 lords-15 lords-16 lords-17
# Издатель держит в памяти снимок поставщика целиком: измерено 1,197 ГиБ пика
# на восьми витринах. Предел ставится выше измеренного, но ниже того, при
# котором на разделе не останется места работающим витринам.
MemoryMax=3G
# Прогон на восьми занял 281 секунду; потолок с запасом на медленный диск.
TimeoutStartSec=2700
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=multi-user.target
