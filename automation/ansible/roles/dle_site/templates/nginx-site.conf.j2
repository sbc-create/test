# Конфигурация сайта {{ site_id }} ({{ environment }}).
# Пути приходят из blueprints/dle20/profiles/paths.yaml — не из догадок.
server {
    listen 443 ssl http2;
    server_name {{ domain }}{% for alias in aliases %} {{ alias }}{% endfor %};

    root {{ site_root }}/current/public;
    index index.php index.html;

    # Служебные пути закрыты от публичного доступа.
{% for path in public_deny_paths %}
    location ~* {{ path }} { deny all; return 404; }
{% endfor %}
    location ~ /\.(?!well-known) { deny all; return 404; }
    location = /routes.json { deny all; return 404; }
    location = /build-manifest.json { deny all; return 404; }
    autoindex off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    # Набор совпадает с проверяемым в factory/verify.py: иначе ворота зелёные на
    # стенде и красные на реальном хосте.
    add_header Content-Security-Policy "{{ content_security_policy }}" always;
    server_tokens off;
{% if environment != 'production' %}
    add_header X-Robots-Tag "noindex, nofollow" always;
    auth_basic "staging";
    auth_basic_user_file {{ site_root }}/shared/htpasswd;
{% endif %}

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        include {{ fastcgi_include }};
        fastcgi_pass unix:{{ fpm_socket }};
    }
}
