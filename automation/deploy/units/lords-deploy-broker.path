[Unit]
Description=Наблюдение за каталогом заявок на выкладку Lords

[Path]
# Заявка кладётся файлом в каталог, доступный на запись пользователю claude.
# Это и есть весь способ запустить выкладку: команда владельца больше не нужна.
DirectoryNotEmpty=/var/lib/lords-deploy/requests
Unit=lords-deploy-broker.service

[Install]
WantedBy=multi-user.target
