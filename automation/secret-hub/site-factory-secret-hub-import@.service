[Unit]
Description=Secret Hub: импорт существующих credentials направления %i
Documentation=file:///srv/site-factory/repo/docs/SECRET_HUB.md
After=site-factory-secret-hub.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/srv/site-factory/repo

LoadCredential=secret_hub_master_key:/etc/site-factory/secrets/secret-hub-master.key

Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/srv/site-factory/repo
Environment=SECRET_HUB_CONFIG=/srv/site-factory/repo/config/secret-hub.json

# Без --archive: оригиналы не трогаются вовсе. Архивировать прежние файлы
# следует отдельным запуском и только после подтверждённой приёмки —
#   sudo systemctl set-environment SECRET_HUB_IMPORT_ARCHIVE=1
# в этом unit'е не предусмотрено намеренно: «архивировать» должно быть
# осознанным действием, а не флагом, который однажды остался включённым.
# Интерпретатор — отдельное окружение Secret Hub, а не .venv репозитория.
# `.venv` там симлинк в /home, а ProtectHome=true делает /home невидимым для
# службы: получалось status=203/EXEC при существующем на вид файле.
ExecStart=/opt/site-factory-secret-hub/venv/bin/python -m factory.secret_hub.rootcmd import %i

TimeoutStartSec=180

ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/site-factory-secret-hub
NoNewPrivileges=true
PrivateTmp=true
LockPersonality=true
LimitCORE=0
