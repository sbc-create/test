[Unit]
Description=Secret Hub: одноразовая форма ввода credentials для направления %i
Documentation=file:///srv/site-factory/repo/docs/SECRET_HUB.md
After=site-factory-secret-hub.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/srv/site-factory/repo

# Одноразовый код печатается в журнал ЭТОГО unit'а, то есть только root'у.
# Ни в ответе HTTP, ни в выводе `factory secrets` его нет: тот, кто запустил
# форму из сессии агента, не должен уметь ею воспользоваться.
LoadCredential=secret_hub_master_key:/etc/site-factory/secrets/secret-hub-master.key

Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/srv/site-factory/repo
Environment=SECRET_HUB_CONFIG=/srv/site-factory/repo/config/secret-hub.json
ExecStart=/srv/site-factory/repo/.venv/bin/python -m factory.secret_hub.rootcmd enroll %i

# Форма живёт максимум 15 минут; лимит стоит чуть выше, чтобы штатное истечение
# TTL завершалось само, а не убивалось таймаутом на полуслове.
TimeoutStartSec=1200

ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/site-factory-secret-hub
NoNewPrivileges=true
PrivateTmp=true
LockPersonality=true
LimitCORE=0

# Фильтр IPAddressAllow здесь НЕ ставится, хотя форма и слушает только петлю.
# Перед записью значения проверяются живым запросом к public-api.cdnvideohub.com,
# и запрет исходящих превратил бы «токен неверен» в «проверка не выполнена» на
# каждом вводе. Ограничение адреса прослушивания живёт в коде (DEFAULT_HOST),
# где оно и осмысленно.
