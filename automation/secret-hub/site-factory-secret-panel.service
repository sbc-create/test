[Unit]
Description=Secret Hub: постоянная веб-панель credentials направлений
Documentation=file:///srv/site-factory/repo/docs/SECRET_HUB.md
After=network-online.target site-factory-secret-hub.service
Wants=network-online.target
Requires=site-factory-secret-hub.service

[Service]
Type=simple
# Непривилегированная учётная запись — принципиально, а не из осторожности.
# Панель принимает запросы из интернета; всё привилегированное (мастер-ключ,
# расшифровка, запись файлов потребителям, перезапуск unit'ов) выполняет
# сервис Secret Hub по ту сторону unix-сокета. Право записывать credentials
# хаб проверяет по uid этой учётной записи через SO_PEERCRED.
User=sfpanel
Group=sfpanel
# Членство в группе управления даёт право обратиться к сокету хаба.
SupplementaryGroups=sfhub
WorkingDirectory=/srv/site-factory/repo

Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/srv/site-factory/repo
Environment=SECRET_HUB_CONFIG=/srv/site-factory/repo/config/secret-hub.json
# Интерпретатор — отдельное окружение Secret Hub, а не .venv репозитория.
# `.venv` там симлинк в /home, а ProtectHome=true делает /home невидимым для
# службы: получалось status=203/EXEC при существующем на вид файле.
ExecStart=/opt/site-factory-secret-hub/venv/bin/python -m factory.secret_hub.panel serve

Restart=on-failure
RestartSec=3

StateDirectory=site-factory-secret-panel
StateDirectoryMode=0700

# Панель слушает только петлю; наружу её выводит nginx, терминируя TLS
# настоящим сертификатом домена.
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/site-factory-secret-panel
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true

# Дамп памяти панели содержал бы значение, которое владелец только что ввёл.
LimitCORE=0

[Install]
WantedBy=multi-user.target
