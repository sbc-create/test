[Unit]
Description=Site Factory Secret Hub (централизованные credentials направлений)
Documentation=file:///srv/site-factory/repo/docs/SECRET_HUB.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/srv/site-factory/repo

# Мастер-ключ приходит через LoadCredential: systemd читает root-owned файл от
# имени PID 1 и кладёт копию в tmpfs, доступную только этому процессу. Значение
# не появляется ни в окружении, ни в `systemctl show`, ни в журнале.
#
# Путь к credential'у вычисляется в коде по $CREDENTIALS_DIRECTORY, а не
# специфером %d: в systemd 249 (Ubuntu 22.04) этого специфера нет, строка молча
# осталась бы literal-ом и сервис падал бы на «файл не найден».
LoadCredential=secret_hub_master_key:/etc/site-factory/secrets/secret-hub-master.key

Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/srv/site-factory/repo
Environment=SECRET_HUB_CONFIG=/srv/site-factory/repo/config/secret-hub.json
# Интерпретатор — отдельное окружение Secret Hub, а не .venv репозитория.
# `.venv` там симлинк в /home, а ProtectHome=true делает /home невидимым для
# службы: получалось status=203/EXEC при существующем на вид файле.
ExecStart=/opt/site-factory-secret-hub/venv/bin/python -m factory.secret_hub serve

Restart=on-failure
RestartSec=3

# Каталог сокета создаётся systemd и исчезает вместе с сервисом.
RuntimeDirectory=site-factory-secret-hub
RuntimeDirectoryMode=0755
StateDirectory=site-factory-secret-hub
StateDirectoryMode=0700

# Журнал сервиса — единственное место, куда печатается одноразовый код формы.
# Он должен оставаться закрытым: читать его может только root.
SyslogLevel=info

# Права по минимуму — но не меньше, чем нужно для работы.
#
# ProtectSystem=strict здесь НЕ ставится: сервис обязан писать файлы credentials
# в /srv/sites/... и /etc/site-factory/secrets/..., то есть ровно туда, куда
# strict запрещает. Вместо этого перечислены конкретные writable-пути, а всё
# остальное закрыто ProtectSystem=full.
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/site-factory-secret-hub
ReadWritePaths=/etc/site-factory/secrets
ReadWritePaths=/etc/systemd/system
ReadWritePaths=/srv/sites/yummyani-staging/runtime/cdnvideohub
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true

# Дамп памяти этого процесса — это дамп всех секретов направлений.
LimitCORE=0

[Install]
WantedBy=multi-user.target
