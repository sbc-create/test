   var dt=(Date.now()-progress.t0)/1000;
   var dc=ct-progress.c0;
   if(dt>=5 && dc>=3){
    progress.ok=true;
    markPlaying('progress+3s', ct);
   } else if(ct>0.05){
    /* Shell is alive; never cover it while media advances. */
    state('active');
   }
