 }
 function mountAt(i){
  idx=i;
  var c=cands[i]; if(!c) return;
  var prev=el();
  if(prev) snapshot(prev);
  destroy();
  поднялся=false; отказ=false; progress={t0:0,c0:0,ok:false};
