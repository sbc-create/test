{
  "schema_version": "COMMENTS_OBSERVABILITY_V1",
  "counters": [
    "api_requests_total",
    "api_errors_total",
    "read_success_total",
    "write_success_total",
    "moderation_outcomes_total",
    "idempotency_conflicts_total",
    "duplicates_rejected_total",
    "rate_limited_total",
    "widget_load_total",
    "widget_ready_total",
    "widget_error_total",
    "hydration_mismatch_total",
    "ssr_render_total",
    "ssr_timeout_total",
    "ssr_cache_hit_total",
    "js_error_free_sessions_total",
    "queue_depth",
    "kill_switch_engaged",
    "cross_tenant_attempts_total"
