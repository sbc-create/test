  "histograms": [
    "api_latency_ms",
    "ssr_latency_ms",
    "widget_ready_ms"
  ],
  "labels": [
    "code",
    "operation",
    "outcome",
    "reason_class",
    "site_id",
    "state",
    "tenant_id",
    "version"
  ],
  "always_labelled_by": [
    "tenant_id",
    "site_id",
    "version"
