<div class="zs">
<header class="zhd">
<div class="zhd__in">
<a class="zhd__logo" href="/">Zona</a>
<button class="zhd__menu" type="button" data-nav-toggle aria-controls="zhd-nav"
 aria-expanded="false" aria-label="Меню разделов">&#9776;</button>
<nav id="zhd-nav" class="zhd__n" aria-label="Разделы"><a href="/">Обзор</a><a href="/new/">Что нового</a><a href="/movies/">Кино</a><a href="/series/">Сериалы</a><a href="/animation/">Анимация</a><a href="/collections/">Подборки</a><a href="/catalog/" aria-current="page">Весь каталог</a></nav>
