{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SeoContentProposal.v1",
  "description": "Предложение авторского SEO-контента. Схема закрыта для неизвестных полей: открытая приняла бы опечатку в имени поля как дополнительные данные, и предложение прошло бы дальше без того, что автор считал переданным.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "resource_kind",
    "site_id",
    "entity_id",
    "entity_kind",
    "surface",
    "locale",
    "fact_pack_ref",
    "source_snapshot_sha256",
    "artifact_ref",
    "artifact_digest",
    "model_version",
    "prompt_version",
    "policy_version",
    "requested_by",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "operations"
  ],
  "properties": {
    "schema_version": {
      "const": "seo.content.proposal/1.0.0"
    },
    "resource_kind": {
      "const": "seo.content.proposal"
    },
    "resource_version": {
      "const": "1",
      "description": "Вычисляется сервером."
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Вычисляется сервером; в запросе не принимается."
    },
    "changeset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Вычисляется сервером."
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Вычисляется сервером."
    },
    "site_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,127}$",
      "description": "Единственный ключ витрины; домен ключом не является."
    },
    "entity_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,127}$",
      "description": "Канонический идентификатор сущности."
    },
    "entity_kind": {
      "enum": [
        "anime.title",
        "anime.episode",
        "catalog.page",
        "collection.page",
        "static.page"
      ]
    },
    "surface": {
      "enum": [
        "title",
        "description",
        "h1",
        "intro",
        "faq",
        "breadcrumbs"
      ]
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
    },
    "fact_pack_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Ссылка на набор фактов реестра."
    },
    "source_snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Отпечаток фактов, по которым составлен текст. Расхождение с текущим снимком — отказ."
    },
    "artifact_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Ссылка на содержимое черновика."
    },
    "artifact_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Отпечаток содержимого."
    },
    "draft_revision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "draft_revision_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "intent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "model_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_./+-]{0,63}$"
    },
    "prompt_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_./+-]{0,63}$"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_./+-]{0,63}$"
    },
    "requested_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Заявленный заказчик; сверяется с опознанным."
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "causation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "rationale": {
      "type": "string",
      "maxLength": 2048
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "op",
          "path",
          "value_digest"
        ],
        "properties": {
          "op": {
            "enum": [
              "set",
              "replace"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^/[A-Za-z0-9_.\\-]+(/[A-Za-z0-9_.\\-]+)*$"
          },
          "value_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "target_environment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Выводится сервером из реестра и политики; присланное значение только сверяется."
    },
    "owner_service": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Выводится сервером из реестра и политики; присланное значение только сверяется."
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Выводится сервером из реестра и политики; присланное значение только сверяется."
    },
    "site_kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Выводится сервером из реестра и политики; присланное значение только сверяется."
    }
  },
  "$id": "https://contracts.site-factory.internal/1.3.2/schemas/SeoContentProposal.v1.json"
}
