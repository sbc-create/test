    "/api/v1/audit/events": {
      "get": {
        "operationId": "listAuditEvents",
        "summary": "Страница журнала по возрастанию ledger_seq",
        "description": "Фильтрация выполняется на сервере. Неизвестный параметр — 422, а не молчаливое игнорирование: провайдер не рекламирует того, чего не делает.",
        "parameters": [
          {
            "name": "site_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "producer_service",
            "in": "query",
            "schema": {
