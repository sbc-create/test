              "application/json": {
                "schema": {
                  "$ref": "https://contracts.site-factory.internal/1.1.0/schemas/AuditCheckpoint.v1.json"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/audit/health": {
      "get": {
        "operationId": "getAuditHealth",
        "summary": "Готовность журнала",
        "description": "Плоскость обслуживания не обязана дожидаться этого ответа: недоступность журнала не должна гасить сайты.",
        "responses": {
          "200": {
            "description": "Состояние"
          }
        }
      }
    },
    "/api/v1/audit/evidence/{evidence_id}/metadata": {
      "get": {
        "operationId": "getEvidenceMetadata",
        "summary": "Метаданные доказательства и результат сверки контрольной суммы",
        "parameters": [
          {
            "name": "evidence_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Метаданные; verified=false при расхождении суммы"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "https://contracts.site-factory.internal/1.1.0/schemas/Problem.v1.json"
                }
              }
            },
            "description": "EVIDENCE_PATH_DENIED"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "https://contracts.site-factory.internal/1.1.0/schemas/Problem.v1.json"
                }
              }
            },
            "description": "Не найдено"
          }
        }
      }
    }
