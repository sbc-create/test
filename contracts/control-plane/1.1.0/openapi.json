            "name": "phase",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "result",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "scope",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "event_type",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "correlation_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "action_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "resource_type",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "resource_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "occurred_from",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "occurred_to",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Страница событий",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "count"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "https://contracts.site-factory.internal/1.1.0/schemas/AuditEvent.v1.json"
                      }
                    },
                    "count": {
                      "type": "integer"
                    },
                    "next_cursor": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "has_more": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "https://contracts.site-factory.internal/1.1.0/schemas/Problem.v1.json"
                }
              }
            },
            "description": "Неизвестный, пустой или противоречивый фильтр"
          }
        }
      },
      "post": {
        "operationId": "appendAuditEvent",
        "summary": "Добавить событие",
        "description": "Идемпотентно по (producer_service, idempotency_key). Повтор того же содержимого — 200 с тем же event_id; другое содержимое под тем же ключом — 409.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "https://contracts.site-factory.internal/1.1.0/schemas/AuditEvent.v1.json"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Событие добавлено"
          },
          "200": {
            "description": "Идемпотентный повтор; событие уже существует"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "https://contracts.site-factory.internal/1.1.0/schemas/Problem.v1.json"
                }
              }
            },
            "description": "Нет или неизвестен токен службы"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "https://contracts.site-factory.internal/1.1.0/schemas/Problem.v1.json"
                }
              }
            },
            "description": "IDENTITY_SPOOF, AUTHORITY_DENIED или MODEL_PHASE_DENIED"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "https://contracts.site-factory.internal/1.1.0/schemas/Problem.v1.json"
                }
              }
            },
            "description": "IDEMPOTENCY_CONFLICT"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "https://contracts.site-factory.internal/1.1.0/schemas/Problem.v1.json"
                }
              }
            },
            "description": "SITE_ID_UNKNOWN, SECRET_IN_PAYLOAD или нарушение схемы"
          }
        }
      },
      "put": {
        "operationId": "auditEventsPutDenied",
        "summary": "Запрещено",
        "description": "Журнал только на добавление.",
        "responses": {
          "405": {
            "content": {
              "application/problem+json": {
